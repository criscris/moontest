# moons v1
main.moon: |
    moon: "1.0"
    doc: |
        Xiaomi-style tower air purifier (real device: 25 x 25 x 56 cm).
        White rounded-square shell whose lower intake band is perforated with
        real through-holes (staggered hex grid, fading out toward the top),
        revealing a dark cylindrical HEPA filter inside. Smooth upper shell with
        a circular front display (silver bezel), dark plinth, and a hollow white
        top well with a visible 9-blade fan under the recessed radial grille.
        Back: flush sensor door with engraved seam and two vent-slot clusters,
        engraved same-color brightness button with LED through-hole, and a
        recessed grip pocket at the top of the perforated filter door.
        Fully parametric in width and height: layout positions scale
        proportionally while real-world detail sizes (hole diameter and pitch,
        wall thicknesses, sensor door, display, pocket) stay fixed, and the
        hole grid regenerates so holes remain round at any size.
    params:
        width:
            default: 0.25
            doc: |
                Footprint width / depth in meters.
            min: 0.15
            max: 0.4
        height:
            default: 0.56
            doc: |
                Total height from floor to top in meters.
            min: 0.3
            max: 0.9
    assets:
        profile:
            op: Rect
            with:
                size:
                    expression: |
                        [params.width, params.width]
                cornerRadius:
                    expression: |
                        [0.22 * params.width, 0.22 * params.width]
        innerRect:
            op: Rect
            with:
                size:
                    expression: |
                        [params.width - 0.018, params.width - 0.018]
                cornerRadius:
                    expression: |
                        [0.2 * params.width, 0.2 * params.width]
        white:
            op: Material
            with:
                color: [0.95, 0.95, 0.96, 1]
                roughness: 0.45
        lightGray:
            op: Material
            with:
                color: [0.84, 0.86, 0.88, 1]
                roughness: 0.6
        midGray:
            op: Material
            with:
                color: [0.58, 0.6, 0.62, 1]
                roughness: 0.65
        dark:
            op: Material
            with:
                color: [0.13, 0.14, 0.15, 1]
                roughness: 0.8
        screenBlack:
            op: Material
            with:
                color: [0.02, 0.02, 0.03, 1]
                roughness: 0.15
        silver:
            op: Material
            with:
                color: [0.85, 0.86, 0.88, 1]
                roughness: 0.25
                metallic: 1
        filterTexture:
            doc: |
                Fine dot pattern of the filter's perforated outer wrap: slightly
                darker holes on dark gray, tiled around the cylinder.
            expression: |
                const n = 128
                const cell = 16
                const [x, y] = Coords({ shape: [n, n] })
                const xo = x % cell - cell / 2
                const yo = y % cell - cell / 2
                const d2 = xo * xo + yo * yo
                const mask = Clamp({ input: (30 - d2) * 0.5, min: 0, max: 1 })
                const v = 0.2 - 0.12 * mask
                return StackAxis({ input: [v, v, v], axis: 2 })
            produces: IMAGE
        filterMaterial:
            op: Material
            with:
                color:
                    asset: filterTexture
                textureSizeInMeters: 0.05
        punchZ:
            doc: |
                The hole punch: a staggered grid of thin cylinders running along
                Z, one row per height step, with radii shrinking to zero toward
                the top of the intake band. Subtracted from the shell tube to
                carve real through-holes in front and back walls at once. Hole
                size and pitch are fixed real-world constants; the grid extents
                regenerate from width and height.
            expression: |
                const W = params.width
                const H = params.height
                const pitch = 0.008
                const holeRadius = 0.0025
                const rowPitch = pitch * 0.866
                const xMax = 0.28 * W + 0.022
                const fadeEnd = 0.696 * H
                const fadeSpan = 0.17 * H
                const parts = []
                let rowIndex = 0
                for (let y = 0.02; y <= fadeEnd - 0.31 * fadeSpan; y += rowPitch) {
                    const t = Math.min(1, Math.max(0, (fadeEnd - y) / fadeSpan))
                    const r = holeRadius * t
                    if (r >= 0.0008) {
                        const off = (rowIndex % 2) * pitch / 2
                        const positions = []
                        for (let x = -xMax + off; x <= xMax + 0.0001; x += pitch) {
                            positions.push([x, y, 0])
                        }
                        const cyl = Transform({
                            input: Cylinder({ height: 1.4 * W, radiusLow: r, resolution: 10 }),
                            rotate: [90, 0, 0]
                        })
                        parts.push(Place({ input: cyl, positions }))
                    }
                    rowIndex++
                }
                return Group(parts)
            produces: MESHES
        punchX:
            op: Transform
            with:
                rotate: [0, 90, 0]
            input:
                asset: punchZ
        backCuts:
            doc: |
                All rear-wall cuts, subtracted from the upper shell: engraved
                seam groove around the flush sensor door, engraved ring seam of
                the brightness button, two clusters of horizontal vent slots
                (left cluster shallow, right cluster cut through so it reads
                dark), and the tiny LED through-hole. Darkness comes from real
                depth, not paint.
            expression: |
                const W = params.width
                const H = params.height
                const face = W / 2
                const doorY = 0.816 * H
                const buttonY = 0.914 * H
                const parts = []
                parts.push(Transform({
                    input: Extrude({
                        input: Difference([
                            Rect({ size: [0.0585, 0.0565], cornerRadius: [0.007, 0.007] }),
                            Rect({ size: [0.0565, 0.0545], cornerRadius: [0.0062, 0.0062] })
                        ]),
                        height: 0.0062
                    }),
                    rotate: [90, 0, 0],
                    translate: [0, doorY, -(face + 0.005)]
                }))
                parts.push(Transform({
                    input: Extrude({
                        input: Difference([
                            Circle({ radius: 0.0115 }),
                            Circle({ radius: 0.0102 })
                        ]),
                        height: 0.0062
                    }),
                    rotate: [90, 0, 0],
                    translate: [0, buttonY, -(face + 0.005)]
                }))
                const throughSize = 0.12 * W + 0.0025
                const throughCenter = -(0.38 * W + throughSize / 2)
                for (let i = 0; i < 7; i++) {
                    const y = doorY - 0.0045 + i * 0.0032
                    parts.push(Transform({
                        input: Box({ size: [0.017, 0.0016, 0.0042] }),
                        translate: [0.0125, y, -(face + 0.0009)]
                    }))
                    parts.push(Transform({
                        input: Box({ size: [0.019, 0.0016, throughSize] }),
                        translate: [-0.0135, y, throughCenter]
                    }))
                }
                parts.push(Transform({
                    input: Cylinder({ height: 0.02, radiusLow: 0.0012, resolution: 12 }),
                    rotate: [90, 0, 0],
                    translate: [0.021, buttonY, -(face - 0.005)]
                }))
                return Group(parts)
            produces: MESHES
        pocketCut:
            doc: |
                Stadium-shaped prism cutting the grip opening through the rear
                wall at the top of the perforated filter door.
            pipe:
              - op: Rect
                with:
                    size: [0.056, 0.02]
                    cornerRadius: [0.009, 0.009]
              - op: Extrude
                with:
                    height: 0.04
              - op: Transform
                with:
                    rotate: [90, 0, 0]
                    translate:
                        expression: |
                            [0, 0.67 * params.height, -(params.width / 2 + 0.02)]
        base:
            pipe:
              - op: Transform
                with:
                    scale: [0.94, 0.94]
                input:
                    asset: profile
              - op: Extrude
                with:
                    height: 0.012
              - op: ApplyMaterial
                with:
                    material:
                        asset: dark
        lowerShell:
            doc: |
                Thin-walled shell tube for the intake band, perforated with real
                holes by subtracting the two punch grids, plus the grip-pocket
                opening.
            pipe:
              - op: Difference
                input:
                    items:
                      - pipe:
                          - op: Difference
                            input:
                                items:
                                  - asset: profile
                                  - op: Offset
                                    with:
                                        delta: -0.0025
                                    input:
                                        asset: profile
                          - op: Extrude
                            with:
                                height:
                                    expression: |
                                        0.702 * params.height - 0.008
                          - op: Transform
                            with:
                                translate: [0, 0.008, 0]
                      - asset: punchZ
                      - asset: punchX
                      - asset: pocketCut
              - op: ApplyMaterial
                with:
                    material:
                        asset: white
        filter:
            doc: |
                Approximation of the real cylindrical HEPA filter, as visible
                through the intake holes: dark perforated wrap with plastic
                end-cap rings at bottom and top. Radius follows the shell so the
                air gap behind the holes stays constant.
            expression: |
                const W = params.width
                const H = params.height
                const rBody = W / 2 - 0.0125
                const rCap = W / 2 - 0.0105
                const topY = 0.643 * H
                const body = Transform({
                    input: TileMaterial({
                        input: ApplyMaterial({
                            input: Cylinder({ height: topY - 0.022, radiusLow: rBody, resolution: 48, anchor: [0.5, 0, 0.5] }),
                            material: assets.filterMaterial
                        })
                    }),
                    translate: [0, 0.024, 0]
                })
                const capBottom = Transform({
                    input: ApplyMaterial({
                        input: Cylinder({ height: 0.014, radiusLow: rCap, resolution: 48, anchor: [0.5, 0, 0.5] }),
                        material: assets.dark
                    }),
                    translate: [0, 0.01, 0]
                })
                const capTop = Transform({
                    input: ApplyMaterial({
                        input: Cylinder({ height: 0.01, radiusLow: rCap, resolution: 48, anchor: [0.5, 0, 0.5] }),
                        material: assets.dark
                    }),
                    translate: [0, topY, 0]
                })
                return Group([body, capBottom, capTop])
            produces: MESHES
        upperShell:
            doc: |
                Hollow upper body: outer wall ring from the intake band top up to
                the very top edge, leaving the top well open. The rear sensor
                door, button, slots, and LED hole are cut into its back wall.
            pipe:
              - op: Difference
                input:
                    items:
                      - pipe:
                          - op: Difference
                            input:
                                items:
                                  - asset: profile
                                  - asset: innerRect
                          - op: Extrude
                            with:
                                height:
                                    expression: |
                                        0.298 * params.height
                          - op: Transform
                            with:
                                translate:
                                    expression: |
                                        [0, 0.702 * params.height, 0]
                      - asset: backCuts
              - op: ApplyMaterial
                with:
                    material:
                        asset: white
        wellWall:
            doc: |
                White funnel wall of the top well: rounded-square outside,
                circular fan opening inside. The rear vent-slot cuts continue
                through it so the sensor slots open into shadowed interior.
            pipe:
              - op: Difference
                input:
                    items:
                      - pipe:
                          - op: Difference
                            input:
                                items:
                                  - asset: innerRect
                                  - op: Circle
                                    with:
                                        radius:
                                            expression: |
                                                0.42 * params.width
                          - op: Extrude
                            with:
                                height: 0.108
                          - op: Transform
                            with:
                                translate:
                                    expression: |
                                        [0, params.height - 0.115, 0]
                      - asset: backCuts
              - op: ApplyMaterial
                with:
                    material:
                        asset: white
        wellFloor:
            pipe:
              - op: Cylinder
                with:
                    height: 0.003
                    radiusLow:
                        expression: |
                            0.416 * params.width
                    anchor: [0.5, 0, 0.5]
              - op: ApplyMaterial
                with:
                    material:
                        asset: dark
              - op: Transform
                with:
                    translate:
                        expression: |
                            [0, params.height - 0.1145, 0]
        fan:
            doc: |
                9-blade axial fan visible through the grille: pitched blades
                around a central hub, sized to the fan opening.
            pipe:
              - expression: |
                    const W = params.width
                    const blades = []
                    for (let i = 0; i < 9; i++) {
                        blades.push(Transform({
                            input: Transform({
                                input: Box({ size: [0.3 * W, 0.0028, 0.028] }),
                                rotate: [32, 0, 0],
                                translate: [0.24 * W, 0, 0]
                            }),
                            rotate: [0, i * 40, 0]
                        }))
                    }
                    const hub = Transform({
                        input: Cylinder({ height: 0.028, radiusLow: 0.128 * W, anchor: [0.5, 0, 0.5] }),
                        translate: [0, -0.014, 0]
                    })
                    return Group([Group(blades), hub])
                produces: MESHES
              - op: ApplyMaterial
                with:
                    material:
                        asset: midGray
              - op: Transform
                with:
                    translate:
                        expression: |
                            [0, params.height - 0.095, 0]
        grille2d:
            expression: |
                const W = params.width
                const s = W / 0.25
                const outer = Rect({ size: [W - 0.02, W - 0.02], cornerRadius: [0.048 * s, 0.048 * s] })
                const rim = Difference([outer, Rect({ size: [W - 0.034, W - 0.034], cornerRadius: [0.042 * s, 0.042 * s] })])
                const ring = Difference([Circle({ radius: 0.078 * s }), Circle({ radius: 0.0735 * s })])
                const hub = Circle({ radius: 0.046 * s })
                const parts = [rim, ring, hub]
                const slats = 72
                const step = 360 / slats
                for (let i = 0; i < slats; i++) {
                    const slat = Transform({
                        input: Transform({
                            input: Rect({ size: [0.512 * W, 0.0022], anchor: [0, 0.5] }),
                            translate: [0.16 * W, 0]
                        }),
                        degrees: i * step
                    })
                    parts.push(slat)
                }
                return Intersection([Union(parts), outer])
            produces: POLYGONS
        grille:
            pipe:
              - asset: grille2d
              - op: Extrude
                with:
                    height: 0.0045
              - op: ApplyMaterial
                with:
                    material:
                        asset: lightGray
              - op: Transform
                with:
                    translate:
                        expression: |
                            [0, params.height - 0.0075, 0]
        hubButton:
            pipe:
              - op: Cylinder
                with:
                    height: 0.0015
                    radiusLow: 0.0075
              - op: ApplyMaterial
                with:
                    material:
                        asset: midGray
              - op: Transform
                with:
                    translate:
                        expression: |
                            [0, params.height - 0.0027, 0.08 * params.width]
        display:
            group:
              - pipe:
                  - op: Cylinder
                    with:
                        height: 0.004
                        radiusLow: 0.036
                  - op: Transform
                    with:
                        rotate: [90, 0, 0]
                        translate:
                            expression: |
                                [0, 0.777 * params.height, params.width / 2 - 0.0005]
                  - op: ApplyMaterial
                    with:
                        material:
                            asset: silver
              - pipe:
                  - op: Cylinder
                    with:
                        height: 0.004
                        radiusLow: 0.0325
                  - op: Transform
                    with:
                        rotate: [90, 0, 0]
                        translate:
                            expression: |
                                [0, 0.777 * params.height, params.width / 2 + 0.0002]
                  - op: ApplyMaterial
                    with:
                        material:
                            asset: screenBlack
        backWhite:
            doc: |
                White rear details: the latch tab under the sensor door and the
                floor of the grip pocket behind its opening.
            pipe:
              - expression: |
                    const W = params.width
                    const H = params.height
                    const face = W / 2
                    const tab = Transform({
                        input: RoundedBox({ size: [0.017, 0.012, 0.002], radius: 0.0008 }),
                        translate: [0, 0.816 * H - 0.0325, -(face + 0.0002)]
                    })
                    const pocketBack = Transform({
                        input: RoundedBox({ size: [0.066, 0.032, 0.012], radius: 0.003 }),
                        translate: [0, 0.67 * H, -(face - 0.019)]
                    })
                    return Group([tab, pocketBack])
                produces: MESHES
              - op: ApplyMaterial
                with:
                    material:
                        asset: white
    render:
        group:
          - asset: base
          - asset: lowerShell
          - asset: filter
          - asset: upperShell
          - asset: wellWall
          - asset: wellFloor
          - asset: fan
          - asset: grille
          - asset: hubButton
          - asset: display
          - asset: backWhite
