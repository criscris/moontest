# moons v1
main.moon: |
    moon: "1.0"
    doc: |
        Barcelona chair (Ludwig Mies van der Rohe, 1929, Knoll) at 1:1 scale.
        Side geometry follows Kimberly Elam's analysis: the chair fits a 750 mm
        square; the front-leg/back bar is a quarter circle of radius S centered
        at the top-front corner of the square; the seat rail is an arc of radius
        S tangent-horizontal at its front tip; the rear leg is an arc of radius
        S/2 centered on the rear edge at half height. Chromed 30x10 mm flat-steel
        bars, leather straps, button-tufted leather cushions (5x4 panels,
        upholstery selectable: pebbled black, pale ivory, or Acqua-style
        chocolate brown).
        Front faces +X (a seated person looks
        toward +X); internally the profile is built facing -X and the final
        assembly is yawed 180 degrees.
    params:
        show_cushions:
            default: true
            category: Appearance
        upholstery:
            default: black
            doc: |
                Cushion leather color.
            category: Appearance
            choices: [black, white, brown]
    assets:
        chromeColorImg:
            doc: |
                Constant chrome albedo as a tiny texture (the texture Material
                variant needs images). Chrome reflects well below an ideal
                mirror (the old 0.95 read as white-hot), slightly rising toward
                blue; ~0.75 keeps the metal bright without the mirror look under
                this environment light.
            expression: |
                const c = [0.85, 0.86, 0.88]
                return Image(StackAxis({
                    input: c.map(v => Fill({ value: v, shape: [4, 4] })),
                    axis: 2
                }))
            produces: IMAGE
        chromeMetalImg:
            expression: |
                return Image(Fill({ value: 1, shape: [768, 768] }))
            produces: IMAGE
        chromeRoughImg:
            doc: |
                Streaked roughness map: fbm noise generated squat and stretched
                vertically, giving faint elongated polishing marks around the
                base roughness instead of a perfectly uniform sheen.
            expression: |
                const f = Noise({ shape: [96, 768], seed: 5, scale: 48, type: "fbm", octaves: 3 })
                const r = Clamp({ input: 0.1 + (f - 0.5) * 0.07, min: 0.03, max: 0.5 })
                return Resize({ input: Image(r), size: [768, 768] })
            produces: IMAGE
        chrome:
            op: Material
            with:
                color:
                    asset: chromeColorImg
                roughness:
                    asset: chromeRoughImg
                metallic:
                    asset: chromeMetalImg
                textureSizeInMeters: 0.35
        leather:
            match:
                param: upholstery
            cases:
                black:
                    op: Material
                    with:
                        color:
                            import: https://assets.moonomat.com/textures/ambientcg/Leather/Leather026_Color.jpg
                        normal:
                            import: https://assets.moonomat.com/textures/ambientcg/Leather/Leather026_NormalGL.jpg
                        roughness:
                            import: https://assets.moonomat.com/textures/ambientcg/Leather/Leather026_Roughness.jpg
                        textureSizeInMeters: 1.0
                white:
                    op: Material
                    with:
                        color:
                            import: https://assets.moonomat.com/textures/ambientcg/Leather/Leather025_Color.jpg
                        normal:
                            import: https://assets.moonomat.com/textures/ambientcg/Leather/Leather025_NormalGL.jpg
                        roughness:
                            import: https://assets.moonomat.com/textures/ambientcg/Leather/Leather025_Roughness.jpg
                        textureSizeInMeters: 1.0
                brown:
                    op: Material
                    with:
                        color:
                            import: https://assets.moonomat.com/textures/ambientcg/Leather/Leather028_Color.jpg
                        normal:
                            import: https://assets.moonomat.com/textures/ambientcg/Leather/Leather028_NormalGL.jpg
                        roughness:
                            import: https://assets.moonomat.com/textures/ambientcg/Leather/Leather028_Roughness.jpg
                        textureSizeInMeters: 1.0
        strapLeather:
            op: Material
            with:
                color: [0.03, 0.03, 0.033, 1]
                roughness: 0.5
                metallic: 0
        frame:
            expression: |
                const res = 10
                const X = d => d - 0.375
                const deg = Math.PI / 180
                // Curve A: quarter circle, center (0, 0.75), centerline radius 0.735
                // (bar is 30 mm deep, so the outer face is the exact Elam circle).
                const A = []
                for (let i = 0; i <= 15; i++) {
                    const t = i * 6 * deg
                    A.push([X(0.744 * Math.sin(t)), 0.75 - 0.744 * Math.cos(t), 0])
                }
                // Curve B, front part (seat rail): radius-S arc, center (0, -0.405),
                // tangent-horizontal at its front tip (0, 0.33). Runs to the
                // tangency point (0.5351, 0.0988). Both arcs reach the junction
                // at the SAME parameter angle 46.7264 deg, so a shared step of
                // 46.7264/6 deg samples each arc exactly to the junction: the
                // front loop ends on it (i = 6), the rear loop resumes one step
                // below (i = 5). A rounded step (the previous 7.78 deg) leaves a
                // 7.8 deg stretch of the rear arc unsampled, and the sweep spline
                // bridges the gap ~0.7 mm inside the true arc (a visible dip in
                // the wall near the rear foot).
                const sB = (46.7264 / 6) * deg
                const B = []
                for (let i = 0; i <= 6; i++) {
                    const t = i * sB
                    B.push([X(0.735 * Math.sin(t)), -0.405 + 0.735 * Math.cos(t), 0])
                }
                // Curve B, rear part (rear leg): arc of centerline radius 0.2951,
                // center (0.75, 0.3011) — exactly TANGENT to the seat-rail arc at
                // the junction (no kink) and tangent to the floor at the rear foot.
                for (let i = 5; i >= 0; i--) {
                    const t = i * sB
                    B.push([X(0.75 - 0.2951 * Math.sin(t)), 0.3011 - 0.2951 * Math.cos(t), 0])
                }
                // Flat-bar section: 30 mm wide (lateral), 12 mm high (in profile).
                const section = Rect({ size: [0.030, 0.012] })
                const bar = pts => Sweep({ input: section, path: pts, resolution: res })
                // Reinforced crossing: one octagonal plate through the eight
                // circle-tangency points (each boundary segment lies inside a bar
                // or inside a subtracted circle -> gap-free), minus four R15
                // circles for the concave corner fillets, as on the original.
                const circle = o => Transform({ input: Circle({ radius: 0.0152, resolution: 256 }), translate: o })
                // Circle centers solved for near-tangency to the two adjacent
                // bar walls (bar A walls: radii 0.738/0.750 about (0, 0.75);
                // seat-rail walls: radii 0.729/0.741 about (0, -0.405)) with a
                // deliberate 0.2 mm penetration INTO each wall: an exactly
                // tangent circle would meet the wall at a grazing 0 deg angle,
                // which makes the Union's intersection edge wander through
                // sliver triangles (a visible hairline on the chrome). The
                // 0.2 mm sink gives a clean ~9 deg crossing that the follow-up
                // normals-only Smooth shades over completely. The octagon
                // vertices are the exact tangency points; they land just inside
                // the sunk circles, so every boundary segment stays hidden
                // inside a bar or a subtracted circle.
                const webs2d = Difference([
                    Polygon({ points: [
                        [0.485285, 0.178165], [0.471379, 0.182215], [0.452429, 0.181846],
                        [0.436223, 0.179088], [0.436058, 0.154641], [0.452279, 0.151708],
                        [0.471272, 0.151187], [0.485168, 0.155083]
                    ] }),
                    circle([0.494812, 0.166574]), circle([0.461714, 0.193629]),
                    circle([0.427463, 0.166901]), circle([0.461452, 0.139847])
                ])
                const web = Transform({
                    input: Extrude({ input: webs2d, height: 0.030 }),
                    rotate: [-90, 0, 0],
                    translate: [-0.375, 0, 0.015]
                })
                // Union (not Group): the two bars and the web are all 30 mm wide
                // and centered, so their side faces are EXACTLY coplanar where
                // they overlap at the crossing. As separate meshes those
                // coincident faces z-fight, showing stepped seam lines on the
                // chrome. Union merges each side into one solid; the follow-up
                // normals-only Smooth (subdivisions: 0) restores smooth shading
                // across the merged curved walls and R15 fillets while
                // minSharpAngle keeps the 90 deg rims crisp.
                const side = Smooth({ input: Union([bar(A), bar(B), web]), subdivisions: 0, minSharpAngle: 45 })
                const sides = Place({ input: side, positions: [[0, 0, -0.36], [0, 0, 0.36]] })
                // Strap bars span exactly between the side bars' inner faces:
                // side bars at z = +/-0.36, 30 mm wide -> inner faces at +/-0.345,
                // so the bar length is precisely 0.69 m (flush butt-joint).
                const cross = (d, y, tilt) => Transform({
                    input: Box({ size: [0.026, 0.012, 0.69] }),
                    rotate: [0, 0, tilt],
                    translate: [X(d), y, 0]
                })
                // All three strap bars are welded between the side bars, co-planar
                // with them: centered on the local arc, wide face along the local
                // tangent. Top bar: back arc nearly vertical -> 90 deg. Shared
                // strap bar: back arc at +46 deg. Front bar: seat-rail apex has a
                // horizontal tangent -> 0 deg.
                const frame = Group([sides, cross(0.7438, 0.737, 90), cross(0.537, 0.235, 46), cross(0.013, 0.330, -1)])
                // TileMaterial generates the UV charts the textured chrome needs
                // (the CSG'd frame has none) and scales them by the material's
                // textureSizeInMeters.
                return TileMaterial({ input: ApplyMaterial({ input: frame, material: assets.chrome }) })
            produces: MESHES
        backStraps:
            expression: |
                const X = d => d - 0.375
                // Straight, taut straps: a chord from the strap bar up to the top
                // bar, wrapping around each (they do NOT follow the curved bars).
                // Bottom: wraps the shared bar from behind, around and including
                // its underside. Top: a complete tight loop around the top bar.
                const path = [
                    [X(0.5211), 0.2298, 0], [X(0.5263), 0.2239, 0], [X(0.5323), 0.2190, 0],
                    [X(0.5432), 0.2292, 0], [X(0.5529), 0.2402, 0],
                    [X(0.5990), 0.3618, 0], [X(0.6450), 0.4834, 0], [X(0.6911), 0.6050, 0],
                    [X(0.7247), 0.6937, 0], [X(0.7328), 0.7153, 0],
                    [X(0.7353), 0.7218, 0], [X(0.7353), 0.7285, 0], [X(0.7353), 0.737, 0], [X(0.7355), 0.7522, 0],
                    [X(0.7438), 0.7528, 0], [X(0.7521), 0.7522, 0], [X(0.7523), 0.737, 0],
                    [X(0.7521), 0.7218, 0], [X(0.7438), 0.7212, 0], [X(0.7368), 0.7213, 0]
                ]
                const strap = Sweep({ input: Rect({ size: [0.036, 0.004] }), path, resolution: 6 })
                // 8 back straps alternating with the 9 seat straps (17 total).
                // 36 mm width < half the 75 mm pitch, so the two sets attach
                // alternately at the shared bar without intersecting.
                const zs = []
                for (let i = 0; i < 8; i++) zs.push([0, 0, -0.2625 + i * 0.075])
                return ApplyMaterial({ input: Place({ input: strap, positions: zs }), material: assets.strapLeather })
            produces: MESHES
        seatStraps:
            expression: |
                // Front-to-back straps: a complete tight loop around the front bar
                // (tail tucked underneath), a straight run back, then over the top
                // of the shared bar, down behind it, ending on its underside.
                const X = d => d - 0.375
                const path = [
                    [X(0.024), 0.3217, 0], [X(0.010), 0.3212, 0], [X(-0.0025), 0.3218, 0],
                    [X(-0.0028), 0.330, 0], [X(-0.0025), 0.3382, 0], [X(0.013), 0.3388, 0],
                    [X(0.022), 0.3386, 0], [X(0.0285), 0.3382, 0],
                    [X(0.045), 0.3357, 0], [X(0.09), 0.3280, 0],
                    [X(0.15), 0.3178, 0], [X(0.30), 0.2922, 0], [X(0.45), 0.2666, 0],
                    [X(0.5417), 0.2510, 0], [X(0.5529), 0.2402, 0], [X(0.5432), 0.2292, 0],
                    [X(0.5323), 0.2190, 0], [X(0.5263), 0.2239, 0], [X(0.5211), 0.2298, 0]
                ]
                const strap = Sweep({ input: Rect({ size: [0.036, 0.004] }), path, resolution: 6 })
                const zs = []
                for (let i = 0; i < 9; i++) zs.push([0, 0, -0.30 + i * 0.075])
                return ApplyMaterial({ input: Place({ input: strap, positions: zs }), material: assets.strapLeather })
            produces: MESHES
        tuftedCushion:
            doc: |
                A rectangular button-tufted leather cushion built as a heightfield:
                nearly flat panels, thin seam lines, button dishes with discs,
                full borders and rounded edge shoulders.
                Lies on XZ, base at Y=0, relief along +Y.
            params:
                sizeX: 0.49
                sizeZ: 0.74
                cellsX: 4
                cellsZ: 5
                maxPuff: 0.031
                base: 0.055
            render:
                expression: |
                    const PI = Math.PI
                    const W = 150, H = 190
                    const [u, v] = Coords({ shape: [H, W], normalize: true })
                    const fu = u * params.cellsX
                    const fv = v * params.cellsZ
                    const cw = params.sizeX / params.cellsX
                    const ch = params.sizeZ / params.cellsZ
                    // Distance (m) to the nearest INTERIOR seam line per axis —
                    // border panels stay high out to the cushion edge (no dip
                    // where there is no button/seam).
                    const ru = Clamp({ input: Round(fu), min: 1, max: params.cellsX - 1 })
                    const rv = Clamp({ input: Round(fv), min: 1, max: params.cellsZ - 1 })
                    const su = (fu - ru) * cw
                    const sv = (fv - rv) * ch
                    // Nearly flat panels with a very subtle crown.
                    const dome = 0.94 + 0.06 * (Sin((fu - Floor(fu)) * PI) * Sin((fv - Floor(fv)) * PI)) ** 0.7
                    // Thin piped seam lines (~5 mm) along the interior seams only.
                    const seamLine = 0.16 * (Exp(-((su / 0.005) ** 2)) + Exp(-((sv / 0.005) ** 2)))
                    // Local dish pulled down around each button (nowhere else —
                    // the outer edges stay full since nothing holds them down).
                    const r2 = su ** 2 + sv ** 2
                    const dish = 0.5 * Exp(-(r2 / 0.0012))
                    const base = dome - seamLine - dish
                    // Button discs at the interior intersections.
                    const btn = 0.58 * Exp(-((r2 / 0.0001) ** 1.5))
                    const relief = Clamp({ input: Maximum({ input: base, other: btn }), min: 0, max: 1 })
                    // Rounded shoulder along the outer edges: the top surface
                    // rolls off in a quarter-round instead of a sharp 90 corner.
                    // Rolled over a wide 45 mm band (not a tight 20 mm one) so
                    // the edge is a gentle slope rather than a near-vertical
                    // wall: a steep face maps a tiny XZ footprint onto a large
                    // vertical extent, stretching the baked UVs into visible
                    // vertical streaks. A shallower roll-off keeps the texel
                    // density even and kills the streaking.
                    const bdu = Minimum({ input: u, other: 1 - u }) * params.sizeX
                    const bdv = Minimum({ input: v, other: 1 - v }) * params.sizeZ
                    const bd = Minimum({ input: bdu, other: bdv })
                    const t = Clamp({ input: bd / 0.045, min: 0, max: 1 })
                    const shoulder = Sqrt(t * (2 - t))
                    const field = Minimum({ input: relief, other: shoulder })
                    return Heightmap({
                        image: Image(field),
                        size: [params.sizeX, params.sizeZ],
                        maxHeight: params.maxPuff,
                        baseThickness: params.base,
                        resolution: [130, 160]
                    })
                produces: MESHES
        seatCushion:
            op: Transform
            with:
                rotate: [0, 0, -9.7]
                translate: [-0.1078, 0.3018, 0]
            input:
                op: BakeMaterial
                input:
                    op: ApplyMaterial
                    with:
                        material:
                            asset: leather
                    input:
                        use:
                            asset: tuftedCushion
                        with:
                            sizeX: 0.573
                            sizeZ: 0.74
                            cellsX: 4
                            cellsZ: 5
                            maxPuff: 0.021
                            base: 0.060
        backCushion:
            op: Transform
            with:
                rotate: [0, 0, 69.26]
                translate: [0.2754, 0.5306, 0]
            input:
                op: BakeMaterial
                input:
                    op: ApplyMaterial
                    with:
                        material:
                            asset: leather
                    input:
                        use:
                            asset: tuftedCushion
                        with:
                            sizeX: 0.45
                            sizeZ: 0.74
                            cellsX: 4
                            cellsZ: 5
                            maxPuff: 0.021
                            base: 0.060
    render:
        op: Transform
        with:
            rotate: [0, 180, 0]
        input:
            if:
                param: show_cushions
            then:
                group:
                  - asset: frame
                  - asset: backStraps
                  - asset: seatStraps
                  - asset: seatCushion
                  - asset: backCushion
            else:
                group:
                  - asset: frame
                  - asset: backStraps
                  - asset: seatStraps
