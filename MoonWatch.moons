# moons v1
main.moon: |
    moon: "1.0"
    doc: |
        MOON — a Bauhaus-minimal automatic dress watch whose single complication is a
        large, geometrically true moonphase at 6 o'clock (see ./assets/moon_watch/moon_display.moon).
        Case Ø 39.5 satin anthracite PVD with polished accents, hairline indices,
        optical box sapphire, 18k champagne hands and moon, coral seconds, black leather.
        World frame: dial in the XY plane facing +Z (+Y = 12 o'clock), caseback at z = 0,
        total thickness 8.8 mm. All dimensions true scale (1 mm = 0.001).
    params:
        hour:
            default: 10
            doc: |
                Hour of day, 0-23 (press pose 10:10:42).
            min: 0
            max: 23
            step: 1
        minute:
            default: 10
            doc: |
                Minute, 0-59.999.
            min: 0
            max: 59.999
            step: 1
        second:
            default: 42
            doc: |
                Second, 0-59.999.
            min: 0
            max: 59.999
            step: 1
        moonDay:
            default: 4.5
            doc: |
                Day of the synodic lunar cycle, passed to the moonphase module:
                0 = new moon, 14.77 = full moon, 29.53 wraps to new.
            min: 0
            max: 29.53059
            step: 0.05
        crystal:
            default: true
            doc: |
                Render the box sapphire crystal (near-clear glass).
        brandText:
            default: MOON
            doc: |
                Brand label on the dial. Long text is scaled down to fit.
    assets:
        # Colors are sRGB hex from the SPEC / DWG-01, converted to linear for Material.
        casePvd:
            # deep anthracite PVD with a fine satin reflection, not chalky matte
            op: Material
            with:
                color: [0.045, 0.052, 0.064, 1]
                roughness: 0.3
                metallic: 1
        casebackSteel:
            # polished anthracite steel gives the rear rim a contrasting highlight
            op: Material
            with:
                color: [0.075, 0.082, 0.095, 1]
                roughness: 0.12
                metallic: 1
        dialLacquer:
            # deep midnight lacquer: controlled sheen supplies depth under the crystal
            op: Material
            with:
                color: [0.0045, 0.0095, 0.034, 1]
                roughness: 0.38
                metallic: 0
        tickSilver:
            # hairline indices #CFD6E4
            op: Material
            with:
                color: [0.624, 0.6724, 0.7758, 1]
                roughness: 0.35
                metallic: 0.6
        wordmarkSilver:
            # "MOON" wordmark #E5E8F0
            op: Material
            with:
                color: [0.7835, 0.807, 0.8714, 1]
                roughness: 0.4
                metallic: 0.5
        subline:
            # "AUTOMATIC" #98A0B4
            op: Material
            with:
                color: [0.314, 0.3515, 0.4564, 1]
                roughness: 0.6
                metallic: 0
        lume:
            # Super-LumiNova old-radium tone #E8DDB5
            op: Material
            with:
                color: [0.807, 0.7231, 0.4621, 1]
                roughness: 0.5
                metallic: 0
        goldChampagne:
            # warm 18k champagne gold; low roughness creates crisp luxury highlights
            op: Material
            with:
                color: [0.72, 0.47, 0.16, 1]
                roughness: 0.16
                metallic: 1
        coral:
            # coral second hand #D0704A
            op: Material
            with:
                color: [0.6308, 0.162, 0.0685, 1]
                roughness: 0.45
                metallic: 0.2
        strapLeather:
            # black leather #151312
            op: Material
            with:
                color: [0.0075, 0.0065, 0.006, 1]
                roughness: 0.9
                metallic: 0
        glass:
            # optical sapphire: subtle cool tint, almost perfectly polished
            op: Material
            with:
                color: [0.82, 0.92, 1, 0.115]
                roughness: 0.018
                metallic: 0
        glyph:
            doc: |
                One letter as 2D outlines — Text cannot be called inside an expression,
                so the expression calls this composition per letter (letterspaced layout).
            params:
                ch: A
                size: 0.002
            render:
                op: Text
                with:
                    text:
                        param: ch
                    fontSize:
                        param: size
                    alignX: left
                    alignY: baseline
        display:
            doc: |
                The 24-blade moonphase module at the requested day.
            use:
                import: ./assets/moon_watch/moon_display.moon
            with:
                moonDay:
                    param: moonDay
    render:
        expression: |
            // ---- constants (mm; SPEC §2 / §9) ----
            const MM = 0.001
            const CASE_R = 19.75        // case band Ø 39.5
            const OPEN_R = 18.35        // crystal opening Ø 36.7
            const DIAL_R = 18.75        // dial plate Ø 37.5
            const APERT = [0, -8.7]     // moon aperture center, world (spec y flipped)
            // z stack (§9): caseback 1.0 · movement 3.6 · module 1.4 · dial 0.4 ·
            // hands 0.9 · box crystal 1.5 → 8.8 total
            const Z_DIAL = 6.0, Z_FACE = 6.4, Z_CASETOP = 7.3, Z_TOP = 8.8

            // 2D built in world XY (y up = 12 o'clock): Extrude(+Y) then rotate −90°
            // about X lands (x2,y2) at world (x,y) with thickness in [z0, z0+th]
            const solid = (poly, z0, th, material) => ApplyMaterial({
                input: Transform({
                    input: Extrude({ input: poly, height: th * MM }),
                    rotate: [-90, 0, 0],
                    translate: [0, 0, (z0 + th) * MM],
                }),
                material,
            })
            // solid of revolution about +Z from an (r, z) mm profile
            const spin = (profile, material, at = [0, 0]) => ApplyMaterial({
                input: Transform({
                    input: Revolve({
                        input: Polygon({ points: profile.map(p => [p[0] * MM, p[1] * MM]) }),
                        resolution: 256,
                    }),
                    rotate: [90, 0, 0],
                    translate: [at[0] * MM, at[1] * MM, 0],
                }),
                material,
            })
            const mm = pts => pts.map(p => [p[0] * MM, p[1] * MM])
            const circleAt = (r, at) => Transform({
                input: Circle({ radius: r * MM, resolution: 192 }),
                translate: [at[0] * MM, at[1] * MM],
            })
            // clock angle a (degrees clockwise from 12) → unit direction in world XY
            const dir = a => [Math.sin(a * Math.PI / 180), Math.cos(a * Math.PI / 180)]

            // ---- case (§2, DWG-01) — revolved profiles, chamfered edges ----
            // caseback: polished disc 1.0 thick
            const caseback = spin([[0, 0], [18.4, 0], [18.9, 0.5], [18.9, 1.0], [0, 1.0]],
                assets.casebackSteel)
            // case band: thin 1.4 ring wall, chamfered top edge
            const band = spin([[OPEN_R, 1.0], [CASE_R, 1.0], [CASE_R, 7.0],
                [19.45, Z_CASETOP], [OPEN_R, Z_CASETOP]], assets.casePvd)
            // corrector hint: Ø 0.8 recess at 8 o'clock (§2.1 / §11), depth 0.35
            const cd = dir(240)
            const corrector = Transform({
                input: Cylinder({ height: 1 * MM, radiusLow: 0.4 * MM, resolution: 48,
                    anchor: [0.5, 0, 0.5] }),
                rotate: [0, 0, 120],
                translate: [cd[0] * 19.5 * MM, cd[1] * 19.5 * MM, 3.6 * MM],
            })
            const caseBody = Difference([Group([caseback, band]), corrector])

            // lugs: slim horns, exact DWG-01 outline (top pair; y-mirrored for bottom)
            const lugTop = Path({ d: "M -11.3 16.2 C -12 18.6 -12 20.5 -12 21.4 L -12 24 L -10 24 L -10 21.4 C -10 19.5 -9.8 17.6 -9.2 16.4 Z" })
            const lugs = [[1, 1], [-1, 1], [1, -1], [-1, -1]].map(([sx, sy]) =>
                solid(Transform({ input: lugTop, scale: [sx * MM, sy * MM] }), 1.6, 2.5,
                    assets.casePvd))

            // crown at 3 o'clock: Ø 3, +2.6 over the band (width incl. crown 42.1)
            const crownProfile = [[0, 0], [0.9, 0], [0.9, 0.75], [1.3, 0.75], [1.5, 1.0],
                [1.5, 2.65], [1.25, 2.9], [0, 2.9]]
            const crown = ApplyMaterial({
                input: Transform({
                    input: Revolve({
                        input: Polygon({ points: mm(crownProfile) }), resolution: 128 }),
                    rotate: [0, 0, -90],
                    translate: [19.45 * MM, 0, 4.15 * MM],
                }),
                material: assets.casePvd,
            })
            // Fine axial knurling on the Ø3 mm grip barrel. Raised flutes stop short of
            // both shoulders so the crown retains its crisp Bauhaus silhouette.
            const crownKnurls = [...Array(36)].map((_, i) => {
                const a = i * 10
                const ar = a * Math.PI / 180
                return ApplyMaterial({
                    input: Transform({
                        input: RoundedBox({
                            size: [1.55 * MM, 0.14 * MM, 0.11 * MM],
                            radius: 0.025 * MM,
                            resolution: 8,
                        }),
                        rotate: [a, 0, 0],
                        translate: [
                            21.25 * MM,
                            1.49 * Math.cos(ar) * MM,
                            (4.15 + 1.49 * Math.sin(ar)) * MM,
                        ],
                    }),
                    material: assets.casePvd,
                })
            })
            const crownAssembly = Group([crown, ...crownKnurls])

            // ---- dial: Ø 37.5 plate with the Ø 10.92 moon opening (DWG-01) ----
            const dial = solid(Difference([Circle({ radius: DIAL_R * MM, resolution: 256 }),
                circleAt(5.46, APERT)]), Z_DIAL, 0.4, assets.dialLacquer)
            // champagne hairline ring Ø 11.44, stroke 0.15, printed on the dial
            const apertureRing = solid(Difference([circleAt(5.795, APERT),
                circleAt(5.645, APERT)]), Z_FACE, 0.02, assets.goldChampagne)

            // ---- dial furniture (§2.1; spec y → world −y) ----
            // radial hairline from rIn to rOut, width w, at clock angle a
            const tick = (a, rIn, rOut, w) => {
                const [dx, dy] = dir(a)
                const [px, py] = [dy, -dx]
                return Polygon({ points: mm([
                    [dx * rIn + px * w / 2, dy * rIn + py * w / 2],
                    [dx * rOut + px * w / 2, dy * rOut + py * w / 2],
                    [dx * rOut - px * w / 2, dy * rOut - py * w / 2],
                    [dx * rIn - px * w / 2, dy * rIn - py * w / 2]]) })
            }
            const minuteTicks = []
            for (let m = 0; m < 60; m++) {
                if (m % 5 === 0) continue                    // 5-min positions omitted
                minuteTicks.push(tick(m * 6, 17.2, 17.9, 0.07))
            }
            // hour indices: inner radius per position (§2.1, 6 yields to the aperture)
            const hourInner = { 0: 12.8, 1: 12.8, 2: 12.8, 3: 13.0, 4: 13.5, 5: 14.4,
                6: 14.9, 7: 14.4, 8: 13.5, 9: 13.0, 10: 12.8, 11: 12.8 }
            const hourTicks = [...Array(12)].map((_, h) =>
                tick(h * 30, hourInner[h], 17.9, 0.10))
            const indices = solid(Group([...minuteTicks, ...hourTicks]), Z_FACE, 0.02,
                assets.tickSilver)
            // lume dots Ø 0.6: pair flanking 12, singles at 3, 9 and 6
            const lumeDots = [[-0.87, 17.4], [0.87, 17.4], [17.4, 0], [-17.4, 0], [0, -17.4]]
                .map(at => solid(circleAt(0.3, at), Z_FACE, 0.03, assets.lume))

            // letterspaced text: lay single glyphs on a cursor, then center the block.
            // Text outlines are SVG-style y-down, so mirror y for the y-up world frame.
            const capOfM = Dimensions({ input: assets.glyph({ ch: "M", size: 1 }) })[1]
            // maxWidth (mm): blocks wider than this are scaled down uniformly so
            // arbitrary label text can never run into the indices or the aperture.
            const word = (text, cap, track, at, material, maxWidth) => {
                const fs = cap * MM / capOfM
                let cursor = 0
                const letters = []
                for (const ch of text) {
                    if (ch === " ") { cursor += 0.6 * fs; continue }
                    const g = assets.glyph({ ch, size: fs })
                    // translate horizontally only — keep each glyph's baseline-
                    // relative y so lowercase/descenders align typographically
                    const left = Bounds({ input: g })[0][0]
                    letters.push(Transform({ input: g, translate: [cursor - left, 0] }))
                    cursor += Dimensions({ input: g })[0] + track * fs
                }
                if (letters.length === 0) return null
                let block = Mirror({ input: Group(letters), axis: [0, 1] })
                if (maxWidth) {
                    const bw = Dimensions({ input: block })[0]
                    if (bw > maxWidth * MM) {
                        const s = maxWidth * MM / bw
                        block = Transform({ input: block, scale: [s, s] })
                    }
                }
                block = Align({ input: block,
                    anchor: [0.5, 0.5], target: [at[0] * MM, at[1] * MM] })
                return solid(block, Z_FACE, 0.02, material)
            }
            const wordmark = word(String(params.brandText), 1.3, 0.4, [0, 6.2],
                assets.wordmarkSilver, 11)
            const automatic = word("AUTOMATIC", 0.75, 0.33, [0, 4.3], assets.subline)

            // ---- moonphase module: 1.4 mm under the dial, origin (= moon center) at the
            // aperture center (§9/§10); module local z=0 (moon-plate face) sits just under
            // the dial opening. The module's plate is movement-concentric (§8), so this
            // one translate lands its hardware case-centered.
            const moonModule = Transform({ input: assets.display,
                translate: [APERT[0] * MM, APERT[1] * MM, 5.65 * MM] })

            // ---- hands (§2.2): straight batons with slight taper, staggered heights ----
            const hourAngle = (params.hour % 12) * 30 + params.minute * 0.5 + params.second / 120
            const minuteAngle = params.minute * 6 + params.second * 0.1
            const secondAngle = params.second * 6
            const baton = (a, len, w0, w1, tail) => Transform({
                input: Polygon({ points: mm([[-w0 / 2, -tail], [-w1 / 2, len],
                    [w1 / 2, len], [w0 / 2, -tail]]) }),
                degrees: -a,                                 // clockwise from 12
            })
            const hourHand = solid(baton(hourAngle, 11.6, 0.60, 0.45, 0.4), 6.50, 0.12,
                assets.goldChampagne)
            const minuteHand = solid(baton(minuteAngle, 16.8, 0.50, 0.36, 0.4), 6.70, 0.12,
                assets.goldChampagne)
            // seconds: coral needle with 2.4 counterweight tail + lume dot at r 15.4
            const secondHand = solid(baton(secondAngle, 17.2, 0.18, 0.18, 2.4), 6.90, 0.09,
                assets.coral)
            const sd = dir(secondAngle)
            const secondLume = solid(circleAt(0.25, [sd[0] * 15.4, sd[1] * 15.4]), 6.99,
                0.03, assets.lume)
            const hub = spin([[0, 6.45], [0.45, 6.45], [0.45, 6.88], [0, 6.88]],
                assets.goldChampagne)
            const hubPin = spin([[0, 6.88], [0.22, 6.88], [0.22, 7.02], [0, 7.02]],
                assets.coral)

            // ---- box crystal: Ø 36.7, proud of the case ~1.5, gently domed top ----
            const domeR = (18.3 ** 2 + 0.35 ** 2) / (2 * 0.35)   // sagitta 0.35 arc
            const domePts = []
            for (let i = 1; i <= 20; i++) {
                const r = 18.3 * (1 - i / 20)
                domePts.push([r, 8.45 + (Math.sqrt(domeR ** 2 - r ** 2) - (domeR - 0.35))])
            }
            const crystal = spin([[0, 7.05], [17.95, 7.05], [18.18, 7.12],
                [18.3, 7.32], [18.3, 8.2], [18.24, 8.36], [18.08, 8.47], ...domePts],
                assets.glass)

            // ---- straps: 20 mm leather, curving gently down away from the lugs;
            // plan-view end corners rounded by intersecting with a rounded-rect prism
            const strapProfile = sign => {
                const top = [], bottom = []
                for (let i = 0; i <= 12; i++) {
                    const y = 20.1 + (31.5 - 20.1) * i / 12
                    const z = 3.5 - 0.007 * (y - 20.1) ** 2
                    top.push([sign * y, z])
                    bottom.unshift([sign * y, z - 1.8])
                }
                return Polygon({ points: mm([...top, ...bottom]) })
            }
            const strapPlan = sign => Transform({
                input: Extrude({
                    input: Transform({
                        input: Rect({ size: [20 * MM, 13 * MM],
                            cornerRadius: [2 * MM, 2 * MM], resolution: 64 }),
                        translate: [0, sign * 25.4 * MM],
                    }),
                    height: 4 * MM,
                }),
                rotate: [-90, 0, 0],
                translate: [0, 0, 4 * MM],
            })
            const straps = [1, -1].map(sign => ApplyMaterial({
                input: Intersection([
                    Transform({
                        input: Extrude({ input: strapProfile(sign), height: 20 * MM }),
                        rotate: [0, 0, 90],
                        translate: [10 * MM, 0, 0],
                    }),
                    strapPlan(sign),
                ]),
                material: assets.strapLeather,
            }))

            const parts = [ApplyMaterial({ input: caseBody, material: assets.casePvd }),
                ...lugs, crownAssembly, dial, apertureRing, indices, ...lumeDots, wordmark,
                automatic, moonModule, hourHand, minuteHand, secondHand, secondLume,
                hub, hubPin, ...straps].filter(Boolean)
            if (params.crystal) parts.push(crystal)
            return Group(parts)
        produces: MESHES
assets/moon_watch/moon_display.moon: |
    moon: "1.0"
    doc: |
        MOON watch — moonphase display module, mask-fan architecture.

        One shade per day of the lunation over ONE static moon: 30 thin midnight
        foils ride a hub sleeve around the motion-works bore, and each is cut away
        exactly where that day's moon is lit. A single galvanic champagne disc sits
        fixed at the display station just beneath them, so the day's lit region
        shines through the cutout while the foil covers the shadow and the sky
        annulus — dark on dark. Display accuracy is cutting accuracy; no motion
        generates the boundary.
        The other 29 shades wait in two spring-fed magazines whose mouths sit at
        ±82.8°, clear of the aperture. Once per day a peripheral transfer ring
        swings the next shade in and the spent one out (ruling R2: arrive, then
        extract — the incoming leaf rides a ramp OVER the one on display, which is
        then drawn out from underneath, so the aperture is never uncovered).
        Both piles rest on the chamber floor (R5): fan A's next leaf is always at
        the bottom, pulled out from under its stack, and fan B's arrivals land on
        top — which leaves B in exactly the order A needs after the monthly reset.
        Set moonDay to a fractional day to watch a changeover; revealMechanism
        exposes the drive train under the leaves.

        Module local frame: moon center (= display station) at the origin, face
        toward +Z, +Y toward 12 o'clock. Hub, ring and plates are movement-
        concentric — center (0, +8.7). All dimensions true scale (1 mm = 0.001).
    params:
        moonDay:
            default: 4.5
            doc: |
                Day of the synodic lunar cycle: 0 = new moon, 7.38 = first quarter,
                14.77 = full moon, 22.15 = last quarter, 29.53 wraps to new.
            min: 0
            max: 29.53059
            step: 0.05
        revealMechanism:
            default: false
            doc: |
                Remove the top guide plate to expose the leaf pile, hub sleeve and
                transfer ring from the front. Default false = watch-facing view.
        explode:
            default: false
            doc: |
                Exploded view for inspection: separates the 30 leaves along +Z only.
                Nothing rotates and nothing shifts laterally — every part keeps its
                exact plan position, so the view stays true to the layout.
    assets:
        # Colors from the MOON spec are sRGB hex; Material color is linear.
        leafPvd:
            # midnight #16264A on the leaf foils (shadow + sky annulus)
            op: Material
            with:
                color: [0.008, 0.0194, 0.0685, 1]
                roughness: 0.5
                metallic: 0.25
        plateLacquer:
            # lacquered midnight on guide/base plates
            op: Material
            with:
                color: [0.008, 0.0194, 0.0685, 1]
                roughness: 0.85
                metallic: 0
        moonChampagne:
            # galvanic 18k champagne moon: luminous, metallic and finely polished
            op: Material
            with:
                color: [0.86, 0.66, 0.3, 1]
                roughness: 0.14
                metallic: 1
        ringSteel:
            # anthracite hub sleeve and plates' hardware
            op: Material
            with:
                color: [0.0423, 0.0482, 0.0578, 1]
                roughness: 0.45
                metallic: 0.9
        steelBright:
            # polished steel transfer ring
            op: Material
            with:
                color: [0.22, 0.23, 0.25, 1]
                roughness: 0.28
                metallic: 1
        giltBrass:
            # gilt drive train (star, leap cam, jumper, springs, stops) —
            # reads against the midnight leaves exactly as in a finished movement
            op: Material
            with:
                color: [0.42, 0.27, 0.09, 1]
                roughness: 0.33
                metallic: 1
    render:
        expression: |
            // ---- constants (mm; display spec rev 0.4 §2) ----
            const MM = 0.001
            const R = 5.0                   // moon radius
            const NL = 30                   // leaves, one per lunation day
            const SYN = 29.53059
            const R_MASK = 5.65             // leaf head radius
            const PIV = 8.7                 // hub -> mask center = aperture offset
            const MOUTH = 82.8              // magazine mouth azimuth (0.4 clearance)
            const PITCH = 1.6               // compressed pile pitch
            const FOIL = 0.03               // foil thickness
            const ZP = 0.031                // pile pitch in z (foil + ride)
            // ---- z-stack (spec §6 / ruling R3), local z. watch.moon places local
            // z = 0 at world 5.65, and the dial underside is world 6.0, so the
            // module ceiling is local +0.35 and the whole stack hangs below it.
            const Z_DIAL = 0.35
            const Z_TOPPLATE = Z_DIAL - 0.13        // top guide plate underside
            const Z0 = Z_TOPPLATE - 0.95            // chamber floor
            const COLLAR_IN = 2.85, COLLAR_OUT = 3.35
            const TAB_R = 14.9, TAB_W = 0.9   // drive tab, clears the head (14.35)
            const STOP_R = 14.7               // mouth stops engage tabs only
            const RING_IN = 15.3, RING_OUT = 18.2
            const PLATE_R = 18.25, BORE_R = 2.5
            const PC = [0, -8.7]            // hub/movement center, SPEC frame

            const day = ((params.moonDay % SYN) + SYN) % SYN
            const kd = Math.min(NL - 1, Math.floor(day * NL / SYN))   // displayed leaf
            // exploded view: pure +Z separation, nothing rotates or shifts in plan
            const EXPL = params.explode ? 0.33 : 0

            const rot = ([x, y], deg) => {
                const a = deg * Math.PI / 180, c = Math.cos(a), s = Math.sin(a)
                return [c * x - s * y, s * x + c * y]
            }
            // leaf pose: rotation about the hub; theta = 0 puts the head on the
            // aperture (SPEC origin). Negative theta = fan A (3 o'clock side).
            const aboutHub = (p, deg) => {
                const r = rot([p[0] - PC[0], p[1] - PC[1]], deg)
                return [PC[0] + r[0], PC[1] + r[1]]
            }
            const headCenter = deg => aboutHub([0, 0], deg)

            // ---- cutout (lit region) of day k (spec §2; area self-checked in
            // maskfan_memo.py against the exact illuminated fraction) ----
            const litPoints = k => {
                const fv = (k + 0.5) / NL
                const c = Math.cos(2 * Math.PI * fv)
                const waxing = fv < 0.5
                const xt = waxing ? c : -c
                const pts = []
                for (let j = 0; j <= 48; j++) {
                    const y = -R + 2 * R * j / 48
                    pts.push([xt * Math.sqrt(Math.max(0, R * R - y * y)), y])
                }
                const a0 = Math.PI / 2
                const a1 = waxing ? -Math.PI / 2 : 3 * Math.PI / 2
                for (let j = 1; j <= 36; j++) {
                    const a = a0 + (a1 - a0) * j / 36
                    pts.push([R * Math.cos(a), R * Math.sin(a)])
                }
                return pts
            }
            // illuminated fraction (1 − cos 2πf)/2 — the guard must test the LIT
            // area, not the sliver width: the sliver is thin at BOTH new and full
            // moon, and at full moon the lit region is the whole disc.
            const litFraction = k => (1 - Math.cos(2 * Math.PI * (k + 0.5) / NL)) / 2

            // ---- 2D helpers (SPEC frame -> world (x, -y), face +Z) ----
            const circle2 = (r, at, res) => Transform({
                input: Circle({ radius: r * MM, resolution: res }),
                translate: [at[0] * MM, at[1] * MM],
            })
            const poly2 = pts => Polygon({ points: pts.map(p => [p[0] * MM, p[1] * MM]) })
            const extrude2 = (shape, z0, th, material) => ApplyMaterial({
                input: Transform({
                    input: Extrude({ input: shape, height: th * MM }),
                    rotate: [90, 0, 0],
                    translate: [0, 0, z0 * MM],
                }),
                material,
            })
            const ringShape = (r0, r1, at, res) =>
                Difference([circle2(r1, at, res), circle2(r0, at, res)])

            // ---- one leaf: head + rim tab + hub collar, minus the bore ----
            const leafSolid = (k, deg, z) => {
                const hc = headCenter(deg)
                const u = rot([0, 1], deg)              // hub -> head axis
                const p = rot([1, 0], deg)              // lateral
                const at = (r, s) => [PC[0] + u[0] * r + p[0] * s,
                                      PC[1] + u[1] * r + p[1] * s]
                const tab = [at(13.4, -TAB_W / 2), at(TAB_R, -TAB_W / 2),
                             at(TAB_R, TAB_W / 2), at(13.4, TAB_W / 2)]
                const solid = Difference([
                    Union([
                        circle2(R_MASK, hc, 96),
                        poly2(tab),
                        circle2(COLLAR_OUT, PC, 64),
                    ]),
                    circle2(COLLAR_IN, PC, 64),
                ])
                // the leaf is a SHADE: its cutout is that day's lit region, through
                // which the one static champagne moon below shines. Near new moon
                // the lit sliver is sub-stampable, so the leaf stays solid (full
                // cover) — the day is dark anyway.
                const shade = litFraction(k) > 0.003
                    ? Difference([solid, poly2(litPoints(k).map(q => aboutHub(q, deg)))])
                    : solid
                return [extrude2(shade, z, FOIL, assets.leafPvd)]
            }

            // ---- magazine layout (spec §3): A = waiting (negative theta),
            // B = used (positive theta); both spring-pressed to their mouths ----
            const PT = PITCH        // pile pitch is a layout constant; the exploded
                                    // view never touches it (it separates in Z only)

            // ---- daily changeover (ruling R2), driven by the fraction of the day
            // slot: the incoming leaf ARRIVES on top of the still-displayed one,
            // and only then is the spent leaf EXTRACTED from under it — so the
            // aperture is never uncovered. Magazine A advances a pitch as its
            // mouth leaf leaves; B's stack settles a pitch as the new one lands.
            const u = day * NL / SYN - kd          // 0..1 within the day slot
            const CH_IN = 0.06, CH_OUT = 0.12
            const sstep = t => {
                const s = Math.max(0, Math.min(1, t))
                return s * s * (3 - 2 * s)
            }
            const adv = sstep(u / CH_IN)                          // arrival progress
            const rec = sstep((u - CH_IN) / (CH_OUT - CH_IN))     // exit progress
            const hasPrev = kd > 0
            const leafAngle = k => {
                if (k === kd) return -MOUTH * (1 - adv)            // swinging in
                if (hasPrev && k === kd - 1)                       // swinging out
                    return MOUTH * rec
                if (k > kd) return -(MOUTH + (k - kd - 1 + 1 - adv) * PT)   // fan A
                return MOUTH + (kd - 1 - k - 1 + rec) * PT                  // fan B
            }
            // z: both piles REST ON THE CHAMBER FLOOR, so height is pile-local,
            // not global rank: A holds kd+1..29 with the next leaf at the bottom
            // (pulled out from under), B holds 0..kd-1 in day order with the last
            // arrival on top (landed on top) — which is exactly the order fan A
            // needs after the monthly block reset.
            // The display station is angularly isolated (no other leaf is ever
            // there), so the leaf rides a fixed ramp UP to the chamber top while
            // displayed: constant, minimal viewing depth all month (ruling R5).
            const Z_DISP = Z_TOPPLATE - 0.05 - FOIL
            const Z_MOON_TOP = Z_DISP - 0.05      // static moon, 0.05 under the shade
            const ZS = ZP + EXPL
            const Z_SHOW = params.explode ? Z0 + NL * ZS : Z_DISP   // display station
            const zArrive = Z_SHOW + FOIL + 0.02  // incoming waits one foil above
            const liftP = sstep(Math.min(1, u / CH_IN * 1.6))   // ramp leads the swing
            const leafZ = k => {
                // The space beneath the display station is occupied by the static
                // moon, so the incoming leaf rides the ramp OVER the displayed one
                // (clearing the moon by a further foil); the spent leaf is then
                // drawn out from underneath and the newcomer settles into place.
                // Adjacent days' cutouts are nested, so the overlap always shows a
                // valid phase and the aperture is never uncovered.
                if (k === kd) return Z0 + (zArrive - Z0) * liftP
                    - (zArrive - Z_SHOW) * rec
                if (hasPrev && k === kd - 1)
                    return Z_SHOW + (Z0 + (kd - 1) * ZS - Z_SHOW) * rec
                if (k > kd) return Z0 + (k - kd - 1 + 1 - adv) * ZS   // A settles
                return Z0 + k * ZS                                    // B, floor up
            }
            const leaves = []
            for (let k = 0; k < NL; k++) {
                leaves.push(...leafSolid(k, leafAngle(k), leafZ(k)))
            }

            // ---- module hardware (all inside the 1.4 mm slot: −0.96 … +0.35) ----
            const Z_BOTGUIDE = Z0 - 0.10
            const Z_BASE = Z_BOTGUIDE - 0.10
            const Z_TOPP = Z_TOPPLATE + (params.explode ? NL * EXPL + 0.35 : 0)
            const hub = extrude2(ringShape(BORE_R, 2.75, PC, 64), Z_BASE,
                Z_TOPP + 0.10 - Z_BASE, assets.ringSteel)
            const basePlate = extrude2(
                Difference([circle2(PLATE_R, PC, 192), circle2(BORE_R, PC, 64)]),
                Z_BASE, 0.10, assets.plateLacquer)
            const bottomGuide = extrude2(ringShape(2.90, 14.6, PC, 160), Z_BOTGUIDE,
                0.10, assets.plateLacquer)
            // top guide plate carries the display opening (dial aperture, r 5.46)
            const topGuide = extrude2(
                Difference([ringShape(2.90, 14.6, PC, 160), circle2(5.55, [0, 0], 96)]),
                Z_TOPP, 0.10, assets.plateLacquer)
            // ---- helpers for fixed hardware ----
            const atPolar = (deg, r, s) => {
                const u = rot([0, 1], deg), p = rot([1, 0], deg)
                return [PC[0] + u[0] * r + p[0] * (s || 0),
                        PC[1] + u[1] * r + p[1] * (s || 0)]
            }
            const sector = (r0, r1, a0, a1, res) => {
                const pts = []
                for (let i = 0; i <= res; i++) pts.push(atPolar(a0 + (a1 - a0) * i / res, r1))
                for (let i = res; i >= 0; i--) pts.push(atPolar(a0 + (a1 - a0) * i / res, r0))
                return poly2(pts)
            }
            const toothWheel = (at, rOut, rIn, n) => {
                const pts = []
                for (let t = 0; t < 2 * n; t++) {
                    const a = Math.PI * t / n, rr = (t % 2 === 0) ? rOut : rIn
                    pts.push([at[0] + rr * Math.cos(a), at[1] + rr * Math.sin(a)])
                }
                return poly2(pts)
            }
            const zChamberH = Z_DISP + FOIL - Z0

            // ---- peripheral drive band (R3): transfer ring with rim teeth and the
            // two pawl fingers that sweep the empty gap sector between the mouths
            const RIM_TEETH = 72
            const finger = deg => poly2([atPolar(deg, 14.4, -0.35), atPolar(deg, 16.2, -0.35),
                                         atPolar(deg, 16.2, 0.35), atPolar(deg, 14.4, 0.35)])
            const rimTeeth = []
            for (let t = 0; t < RIM_TEETH; t++) {
                const a = 360 * t / RIM_TEETH
                rimTeeth.push(poly2([atPolar(a, RING_OUT - 0.05, -0.28),
                                     atPolar(a, RING_OUT + 0.22, 0),
                                     atPolar(a, RING_OUT - 0.05, 0.28)]))
            }
            const transferRing = extrude2(
                Union([ringShape(RING_IN, RING_OUT, PC, 192), finger(0), finger(-MOUTH),
                       ...rimTeeth]),
                Z0 + 0.34, 0.10, assets.steelBright)

            // ---- magazine mouth stops: posts that catch the tabs (only the tabs
            // reach r 14.9; the heads stop at 14.35) ----
            const stops = [MOUTH, -MOUTH].map(deg => extrude2(
                circle2(0.30, atPolar(deg, STOP_R), 20), Z0 - 0.02, zChamberH + 0.04,
                assets.giltBrass))

            // ---- magazine springs: curved leaf springs pressing each pile toward
            // its mouth, anchored at the deep end of the fan ----
            const deepA = -(MOUTH + (NL - 1) * PITCH), deepB = MOUTH + (NL - 1) * PITCH
            const springs = [[deepA, -22], [deepB, 22]].map(([a0, sweep]) => extrude2(
                Union([sector(11.9, 12.25, a0, a0 + sweep, 24),
                       circle2(0.45, atPolar(a0 + sweep, 12.07), 16)]),
                Z0 + 0.05, zChamberH - 0.1, assets.giltBrass))

            // ---- registration jumper at the display station: sprung lever seating
            // the display tab (the module's single precision joint) ----
            const jumper = extrude2(
                Union([poly2([atPolar(0, 14.35, -0.55), atPolar(0, 15.9, -0.30),
                              atPolar(0, 15.9, 0.30), atPolar(0, 14.35, 0.55)]),
                       sector(15.4, 15.75, 3, 26, 12),
                       circle2(0.40, atPolar(26, 15.57), 16)]),
                Z0 + 0.14, 0.10, assets.giltBrass)

            // ---- the ONE static moon: galvanic champagne disc at the display
            // station, carried on a short pillar from the chamber floor. Every
            // shade flies over it (the ramp lifts them clear before they reach the
            // station), and each day's cutout lets exactly that day's lit region
            // shine through — one gold surface for the whole complication.
            const moonDisc = extrude2(circle2(R, [0, 0], 160), Z_MOON_TOP - 0.12, 0.12,
                assets.moonChampagne)
            const moonPost = extrude2(circle2(1.8, [0, 0], 32), Z0, Z_MOON_TOP - 0.12 - Z0,
                assets.ringSteel)

            // ---- R5 lift ramp: raises the incoming shade from fan A's floor to
            // above the display station — leading the angular swing, so the leaf is
            // clear of the static moon well before it arrives ----
            // The lift acts on the leaf's COLLAR, as a helical track on the hub
            // sleeve (r 2.9–3.5): the only band that clears the static moon, whose
            // near edge is 3.7 from the hub. It stops short of the station (−12°),
            // by which point the leaf is fully raised and settles onto its seat.
            const RAMP_END = -12
            const rampSteps = []
            for (let i = 0; i < 14; i++) {
                const span = MOUTH + RAMP_END
                const a0 = -MOUTH + span * i / 14, a1 = -MOUTH + span * (i + 1) / 14
                // top face stays 0.025 under the leaf it carries, never above it
                const h = 0.03 + (zArrive - 0.035 - Z0)
                    * sstep(Math.min(1, (i + 1) / 14 * 1.6))
                // steel, not gilt: this track encircles the bore and is the one
                // drive part that can be glimpsed from the front
                rampSteps.push(extrude2(sector(2.9, 3.5, a0, a1 + 0.6, 4), Z0 - 0.02, h,
                    assets.steelBright))
            }

            // ---- drive train (spec §7): 59-tooth program star, its advance finger
            // from the movement's date train, and the 16-position leap cam ----
            const starAt = atPolar(148, 15.4)
            const leapAt = atPolar(-148, 15.4)
            const dressing = [
                extrude2(toothWheel(starAt, 2.60, 2.25, 59), Z0 + 0.02, 0.09, assets.giltBrass),
                extrude2(circle2(0.5, starAt, 16), Z0 - 0.02, 0.16, assets.ringSteel),
                extrude2(toothWheel(leapAt, 1.90, 1.55, 16), Z0 + 0.02, 0.09, assets.giltBrass),
                extrude2(circle2(0.45, leapAt, 16), Z0 - 0.02, 0.16, assets.ringSteel),
                // date-train finger reaching the star
                extrude2(poly2([[starAt[0] - 0.35, starAt[1] + 2.2],
                                [starAt[0] + 0.35, starAt[1] + 2.4],
                                [starAt[0] + 1.9, starAt[1] + 5.3],
                                [starAt[0] + 1.0, starAt[1] + 5.5]]),
                    Z0 + 0.13, 0.09, assets.giltBrass),
            ]

            const parts = [basePlate, bottomGuide, hub, transferRing, ...stops,
                ...springs, jumper, ...rampSteps, ...dressing, moonPost, moonDisc,
                ...leaves]
            if (!params.revealMechanism) parts.push(topGuide)
            return Group(parts)
        produces: MESHES
main.moon.webp: !!binary |
