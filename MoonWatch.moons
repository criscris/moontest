# moons v1
main.moon: |
    moon: "1.0"
    doc: |
        MOON — a Bauhaus-minimal automatic dress watch whose single complication is a
        large, geometrically true moonphase at 6 o'clock (see ./moon_display.moon).
        Case Ø 39.5 anthracite PVD, hairline indices, edge-to-edge box crystal,
        champagne hands, coral second hand, black leather strap.
        World frame: dial in the XY plane facing +Z (+Y = 12 o'clock), caseback at z = 0,
        total thickness 8.8 mm. All dimensions true scale (1 mm = 0.001).
    params:
        hour:
            default: 10
            doc: |
                Hour of day, 0-23 (press pose 10:10:42).
            min: 0
            max: 23
            step: 1
        minute:
            default: 10
            doc: |
                Minute, 0-59.999.
            min: 0
            max: 59.999
            step: 1
        second:
            default: 42
            doc: |
                Second, 0-59.999.
            min: 0
            max: 59.999
            step: 1
        moonDay:
            default: 4.5
            doc: |
                Day of the synodic lunar cycle, passed to the moonphase module:
                0 = new moon, 14.77 = full moon, 29.53 wraps to new.
            min: 0
            max: 29.53059
            step: 0.05
        crystal:
            default: true
            doc: |
                Render the box sapphire crystal (near-clear glass).
    assets:
        # Colors are sRGB hex from the SPEC / DWG-01, converted to linear for Material.
        casePvd:
            # anthracite PVD matte #43464C
            op: Material
            with:
                color: [0.0561, 0.0612, 0.0723, 1]
                roughness: 0.55
                metallic: 0.9
        casebackSteel:
            # same anthracite, polished
            op: Material
            with:
                color: [0.0561, 0.0612, 0.0723, 1]
                roughness: 0.25
                metallic: 0.95
        dialLacquer:
            # midnight blue-black #111C38 matte
            op: Material
            with:
                color: [0.0056, 0.0116, 0.0395, 1]
                roughness: 0.85
                metallic: 0
        tickSilver:
            # hairline indices #CFD6E4
            op: Material
            with:
                color: [0.624, 0.6724, 0.7758, 1]
                roughness: 0.35
                metallic: 0.6
        wordmarkSilver:
            # "MOON" wordmark #E5E8F0
            op: Material
            with:
                color: [0.7835, 0.807, 0.8714, 1]
                roughness: 0.4
                metallic: 0.5
        subline:
            # "AUTOMATIC" #98A0B4
            op: Material
            with:
                color: [0.314, 0.3515, 0.4564, 1]
                roughness: 0.6
                metallic: 0
        lume:
            # Super-LumiNova old-radium tone #E8DDB5
            op: Material
            with:
                color: [0.807, 0.7231, 0.4621, 1]
                roughness: 0.5
                metallic: 0
        goldChampagne:
            # champagne gold #C8A76A (hands, hub, aperture ring — DWG-01 tone)
            op: Material
            with:
                color: [0.5776, 0.3864, 0.1441, 1]
                roughness: 0.3
                metallic: 0.9
        coral:
            # coral second hand #D0704A
            op: Material
            with:
                color: [0.6308, 0.162, 0.0685, 1]
                roughness: 0.45
                metallic: 0.2
        strapLeather:
            # black leather #151312
            op: Material
            with:
                color: [0.0075, 0.0065, 0.006, 1]
                roughness: 0.9
                metallic: 0
        glass:
            # box sapphire: near-clear, must never obscure the dial
            op: Material
            with:
                color: [0.9, 0.95, 1, 0.14]
                roughness: 0.08
                metallic: 0
        glyph:
            doc: |
                One letter as 2D outlines — Text cannot be called inside an expression,
                so the expression calls this composition per letter (letterspaced layout).
            params:
                ch: A
                size: 0.002
            render:
                op: Text
                with:
                    text:
                        param: ch
                    fontSize:
                        param: size
                    alignX: left
                    alignY: baseline
        display:
            doc: |
                The 24-blade moonphase module at the requested day.
            use:
                import: ./moon_display.moon
            with:
                moonDay:
                    param: moonDay
    render:
        expression: |
            // ---- constants (mm; SPEC §2 / §9) ----
            const MM = 0.001
            const CASE_R = 19.75        // case band Ø 39.5
            const OPEN_R = 18.35        // crystal opening Ø 36.7
            const DIAL_R = 18.75        // dial plate Ø 37.5
            const APERT = [0, -8.7]     // moon aperture center, world (spec y flipped)
            // z stack (§9): caseback 1.0 · movement 3.6 · module 1.4 · dial 0.4 ·
            // hands 0.9 · box crystal 1.5 → 8.8 total
            const Z_DIAL = 6.0, Z_FACE = 6.4, Z_CASETOP = 7.3, Z_TOP = 8.8

            // 2D built in world XY (y up = 12 o'clock): Extrude(+Y) then rotate −90°
            // about X lands (x2,y2) at world (x,y) with thickness in [z0, z0+th]
            const solid = (poly, z0, th, material) => ApplyMaterial({
                input: Transform({
                    input: Extrude({ input: poly, height: th * MM }),
                    rotate: [-90, 0, 0],
                    translate: [0, 0, (z0 + th) * MM],
                }),
                material,
            })
            // solid of revolution about +Z from an (r, z) mm profile
            const spin = (profile, material, at = [0, 0]) => ApplyMaterial({
                input: Transform({
                    input: Revolve({
                        input: Polygon({ points: profile.map(p => [p[0] * MM, p[1] * MM]) }),
                        resolution: 256,
                    }),
                    rotate: [90, 0, 0],
                    translate: [at[0] * MM, at[1] * MM, 0],
                }),
                material,
            })
            const mm = pts => pts.map(p => [p[0] * MM, p[1] * MM])
            const circleAt = (r, at) => Transform({
                input: Circle({ radius: r * MM, resolution: 192 }),
                translate: [at[0] * MM, at[1] * MM],
            })
            // clock angle a (degrees clockwise from 12) → unit direction in world XY
            const dir = a => [Math.sin(a * Math.PI / 180), Math.cos(a * Math.PI / 180)]

            // ---- case (§2, DWG-01) — revolved profiles, chamfered edges ----
            // caseback: polished disc 1.0 thick
            const caseback = spin([[0, 0], [18.4, 0], [18.9, 0.5], [18.9, 1.0], [0, 1.0]],
                assets.casebackSteel)
            // case band: thin 1.4 ring wall, chamfered top edge
            const band = spin([[OPEN_R, 1.0], [CASE_R, 1.0], [CASE_R, 7.0],
                [19.45, Z_CASETOP], [OPEN_R, Z_CASETOP]], assets.casePvd)
            // corrector hint: Ø 0.8 recess at 8 o'clock (§2.1 / §11), depth 0.35
            const cd = dir(240)
            const corrector = Transform({
                input: Cylinder({ height: 1 * MM, radiusLow: 0.4 * MM, resolution: 48,
                    anchor: [0.5, 0, 0.5] }),
                rotate: [0, 0, 120],
                translate: [cd[0] * 19.5 * MM, cd[1] * 19.5 * MM, 3.6 * MM],
            })
            const caseBody = Difference([Group([caseback, band]), corrector])

            // lugs: slim horns, exact DWG-01 outline (top pair; y-mirrored for bottom)
            const lugTop = Path({ d: "M -11.3 16.2 C -12 18.6 -12 20.5 -12 21.4 L -12 24 L -10 24 L -10 21.4 C -10 19.5 -9.8 17.6 -9.2 16.4 Z" })
            const lugs = [[1, 1], [-1, 1], [1, -1], [-1, -1]].map(([sx, sy]) =>
                solid(Transform({ input: lugTop, scale: [sx * MM, sy * MM] }), 1.6, 2.5,
                    assets.casePvd))

            // crown at 3 o'clock: Ø 3, +2.6 over the band (width incl. crown 42.1)
            const crownProfile = [[0, 0], [0.9, 0], [0.9, 0.75], [1.3, 0.75], [1.5, 1.0],
                [1.5, 2.65], [1.25, 2.9], [0, 2.9]]
            const crown = ApplyMaterial({
                input: Transform({
                    input: Revolve({
                        input: Polygon({ points: mm(crownProfile) }), resolution: 128 }),
                    rotate: [0, 0, -90],
                    translate: [19.45 * MM, 0, 4.15 * MM],
                }),
                material: assets.casePvd,
            })
            // Fine axial knurling on the Ø3 mm grip barrel. Raised flutes stop short of
            // both shoulders so the crown retains its crisp Bauhaus silhouette.
            const crownKnurls = [...Array(36)].map((_, i) => {
                const a = i * 10
                const ar = a * Math.PI / 180
                return ApplyMaterial({
                    input: Transform({
                        input: RoundedBox({
                            size: [1.55 * MM, 0.14 * MM, 0.11 * MM],
                            radius: 0.025 * MM,
                            resolution: 8,
                        }),
                        rotate: [a, 0, 0],
                        translate: [
                            21.25 * MM,
                            1.49 * Math.cos(ar) * MM,
                            (4.15 + 1.49 * Math.sin(ar)) * MM,
                        ],
                    }),
                    material: assets.casePvd,
                })
            })
            const crownAssembly = Group([crown, ...crownKnurls])

            // ---- dial: Ø 37.5 plate with the Ø 10.92 moon opening (DWG-01) ----
            const dial = solid(Difference([Circle({ radius: DIAL_R * MM, resolution: 256 }),
                circleAt(5.46, APERT)]), Z_DIAL, 0.4, assets.dialLacquer)
            // champagne hairline ring Ø 11.44, stroke 0.15, printed on the dial
            const apertureRing = solid(Difference([circleAt(5.795, APERT),
                circleAt(5.645, APERT)]), Z_FACE, 0.02, assets.goldChampagne)

            // ---- dial furniture (§2.1; spec y → world −y) ----
            // radial hairline from rIn to rOut, width w, at clock angle a
            const tick = (a, rIn, rOut, w) => {
                const [dx, dy] = dir(a)
                const [px, py] = [dy, -dx]
                return Polygon({ points: mm([
                    [dx * rIn + px * w / 2, dy * rIn + py * w / 2],
                    [dx * rOut + px * w / 2, dy * rOut + py * w / 2],
                    [dx * rOut - px * w / 2, dy * rOut - py * w / 2],
                    [dx * rIn - px * w / 2, dy * rIn - py * w / 2]]) })
            }
            const minuteTicks = []
            for (let m = 0; m < 60; m++) {
                if (m % 5 === 0) continue                    // 5-min positions omitted
                minuteTicks.push(tick(m * 6, 17.2, 17.9, 0.07))
            }
            // hour indices: inner radius per position (§2.1, 6 yields to the aperture)
            const hourInner = { 0: 12.8, 1: 12.8, 2: 12.8, 3: 13.0, 4: 13.5, 5: 14.4,
                6: 14.9, 7: 14.4, 8: 13.5, 9: 13.0, 10: 12.8, 11: 12.8 }
            const hourTicks = [...Array(12)].map((_, h) =>
                tick(h * 30, hourInner[h], 17.9, 0.10))
            const indices = solid(Group([...minuteTicks, ...hourTicks]), Z_FACE, 0.02,
                assets.tickSilver)
            // lume dots Ø 0.6: pair flanking 12, singles at 3, 9 and 6
            const lumeDots = [[-0.87, 17.4], [0.87, 17.4], [17.4, 0], [-17.4, 0], [0, -17.4]]
                .map(at => solid(circleAt(0.3, at), Z_FACE, 0.03, assets.lume))

            // letterspaced text: lay single glyphs on a cursor, then center the block.
            // Text outlines are SVG-style y-down, so mirror y for the y-up world frame.
            const capOfM = Dimensions({ input: assets.glyph({ ch: "M", size: 1 }) })[1]
            const word = (text, cap, track, at, material) => {
                const fs = cap * MM / capOfM
                let cursor = 0
                const letters = []
                for (const ch of text) {
                    const g = assets.glyph({ ch, size: fs })
                    letters.push(Align({ input: g, anchor: [0, 0], target: [cursor, 0] }))
                    cursor += Dimensions({ input: g })[0] + track * fs
                }
                const block = Align({
                    input: Mirror({ input: Group(letters), axis: [0, 1] }),
                    anchor: [0.5, 0.5], target: [at[0] * MM, at[1] * MM] })
                return solid(block, Z_FACE, 0.02, material)
            }
            const wordmark = word("MOON", 1.3, 0.4, [0, 6.2], assets.wordmarkSilver)
            const automatic = word("AUTOMATIC", 0.75, 0.33, [0, 4.3], assets.subline)

            // ---- moonphase module: 1.4 mm under the dial at world (0, −8.7) (§9/§10);
            // module local z=0 (moon-plate face) sits just under the dial opening.
            // The module's standalone Ø 36.5 plate is clipped to the case interior —
            // in the watch the hardware stops at the case wall (§10 envelope).
            const moonModule = Intersection([
                Transform({ input: assets.display,
                    translate: [APERT[0] * MM, APERT[1] * MM, 5.65 * MM] }),
                Transform({
                    input: Cylinder({ height: 1.7 * MM, radiusLow: 18.3 * MM,
                        resolution: 192, anchor: [0.5, 0, 0.5] }),
                    rotate: [90, 0, 0],
                    translate: [0, 0, 4.55 * MM],
                }),
            ])

            // ---- hands (§2.2): straight batons with slight taper, staggered heights ----
            const hourAngle = (params.hour % 12) * 30 + params.minute * 0.5 + params.second / 120
            const minuteAngle = params.minute * 6 + params.second * 0.1
            const secondAngle = params.second * 6
            const baton = (a, len, w0, w1, tail) => Transform({
                input: Polygon({ points: mm([[-w0 / 2, -tail], [-w1 / 2, len],
                    [w1 / 2, len], [w0 / 2, -tail]]) }),
                degrees: -a,                                 // clockwise from 12
            })
            const hourHand = solid(baton(hourAngle, 11.6, 0.60, 0.45, 0.4), 6.50, 0.12,
                assets.goldChampagne)
            const minuteHand = solid(baton(minuteAngle, 16.8, 0.50, 0.36, 0.4), 6.70, 0.12,
                assets.goldChampagne)
            // seconds: coral needle with 2.4 counterweight tail + lume dot at r 15.4
            const secondHand = solid(baton(secondAngle, 17.2, 0.18, 0.18, 2.4), 6.90, 0.09,
                assets.coral)
            const sd = dir(secondAngle)
            const secondLume = solid(circleAt(0.25, [sd[0] * 15.4, sd[1] * 15.4]), 6.99,
                0.03, assets.lume)
            const hub = spin([[0, 6.45], [0.45, 6.45], [0.45, 6.88], [0, 6.88]],
                assets.goldChampagne)
            const hubPin = spin([[0, 6.88], [0.22, 6.88], [0.22, 7.02], [0, 7.02]],
                assets.coral)

            // ---- box crystal: Ø 36.7, proud of the case ~1.5, gently domed top ----
            const domeR = (18.3 ** 2 + 0.35 ** 2) / (2 * 0.35)   // sagitta 0.35 arc
            const domePts = []
            for (let i = 1; i <= 20; i++) {
                const r = 18.3 * (1 - i / 20)
                domePts.push([r, 8.45 + (Math.sqrt(domeR ** 2 - r ** 2) - (domeR - 0.35))])
            }
            const crystal = spin([[0, 7.05], [17.95, 7.05], [18.18, 7.12],
                [18.3, 7.32], [18.3, 8.2], [18.24, 8.36], [18.08, 8.47], ...domePts],
                assets.glass)

            // ---- straps: 20 mm leather, curving gently down away from the lugs;
            // plan-view end corners rounded by intersecting with a rounded-rect prism
            const strapProfile = sign => {
                const top = [], bottom = []
                for (let i = 0; i <= 12; i++) {
                    const y = 20.1 + (31.5 - 20.1) * i / 12
                    const z = 3.5 - 0.007 * (y - 20.1) ** 2
                    top.push([sign * y, z])
                    bottom.unshift([sign * y, z - 1.8])
                }
                return Polygon({ points: mm([...top, ...bottom]) })
            }
            const strapPlan = sign => Transform({
                input: Extrude({
                    input: Transform({
                        input: Rect({ size: [20 * MM, 13 * MM],
                            cornerRadius: [2 * MM, 2 * MM], resolution: 64 }),
                        translate: [0, sign * 25.4 * MM],
                    }),
                    height: 4 * MM,
                }),
                rotate: [-90, 0, 0],
                translate: [0, 0, 4 * MM],
            })
            const straps = [1, -1].map(sign => ApplyMaterial({
                input: Intersection([
                    Transform({
                        input: Extrude({ input: strapProfile(sign), height: 20 * MM }),
                        rotate: [0, 0, 90],
                        translate: [10 * MM, 0, 0],
                    }),
                    strapPlan(sign),
                ]),
                material: assets.strapLeather,
            }))

            const parts = [ApplyMaterial({ input: caseBody, material: assets.casePvd }),
                ...lugs, crownAssembly, dial, apertureRing, indices, ...lumeDots, wordmark,
                automatic, moonModule, hourHand, minuteHand, secondHand, secondLume,
                hub, hubPin, ...straps]
            if (params.crystal) parts.push(crystal)
            return Group(parts)
        produces: MESHES
main.params.moon: |
    moon: "1.0"
    doc: |
        Parameter override for ./main.moon
    render:
        use:
            import: "./main.moon"
        with:
            moonDay: 1.75
moon_display.moon: |
    moon: "1.0"
    doc: |
        MOON watch — moonphase display module: a 24-blade "iris" shutter that shows the
        astronomically true lunar terminator x(y) = cos(2πf)·√(R²−y²) for any day of the
        synodic cycle, placed per the SPEC §5 blade law — including gibbous phases and
        tapering crescent tips that the classic twin-hump moonphase cannot render.
        (Within ~2 days of new moon the §5 sky-overshoot deliberately trims the last
        ~0.3 mm of tip height — error suppressed toward the sky per SPEC §7.)
        Two banks of 12 midnight-PVD blades (bank L covers the waxing shadow from the left,
        bank R the waning shadow from the right) slide over a champagne moon disc printed
        on a brass plate. Every blade edge carries one chord segment of the terminator;
        seams hide behind 55° flaps, pole caps overshoot into the dark sky, and parked
        blades wait just off the moon's limb — dark on dark, invisible.
        Module local frame: moon center at the origin, face toward +Z, +Y toward 12 o'clock.
        All dimensions true scale (1 mm = 0.001).
    params:
        moonDay:
            default: 4.5
            doc: |
                Day of the synodic lunar cycle: 0 = new moon, 7.38 = first quarter,
                14.77 = full moon, 22.15 = last quarter, 29.53 wraps to new.
            min: 0
            max: 29.53059
            step: 0.05
    assets:
        # Colors from the MOON spec are sRGB hex; Material color is linear — values below
        # are the sRGB→linear conversions.
        bladePvd:
            # PVD midnight #16264A on all blade faces — dark-on-dark hides the mechanism
            op: Material
            with:
                color: [0.008, 0.0194, 0.0685, 1]
                roughness: 0.5
                metallic: 0.25
        skyLacquer:
            # lacquered night sky #16264A on the moon plate
            op: Material
            with:
                color: [0.008, 0.0194, 0.0685, 1]
                roughness: 0.85
                metallic: 0
        moonChampagne:
            # galvanic champagne #F0E4C2 moon disc
            op: Material
            with:
                color: [0.8714, 0.7758, 0.5395, 1]
                roughness: 0.32
                metallic: 0.85
        ringSteel:
            # anthracite cam-ring hint at the module perimeter
            op: Material
            with:
                color: [0.0423, 0.0482, 0.0578, 1]
                roughness: 0.45
                metallic: 0.9
    render:
        expression: |
            // ---- MOON spec §4 — fixed definitions (all lengths in mm) ----
            const MM = 0.001                    // model at true scale: 1 mm = 0.001 m
            const R = 5                         // moon radius
            const N = 12                        // blades per bank
            const SYN = 29.53059                // synodic month, days
            const PK = 0.17                     // parked clearance off the limb (§5.2)
            const TH = 0.12                     // blade thickness (§8)
            const FLAP = 0.55, FLAP_DEG = 55    // interior-tip bevel flap (§5.1)
            const CAP = 1.2, CAP_Y = R + 0.35   // pole-cap length and tip |y| (§5.1)

            const day = ((params.moonDay % SYN) + SYN) % SYN
            const f = day / SYN                 // phase fraction: waxing f < 0.5, waning f >= 0.5
            const c = Math.cos(2 * Math.PI * f) // phase parameter
            const w = Math.max(0, c) ** 6       // limb-bias weight, active near new moon (§5 step 3)
            const E = Math.min(1, Math.abs(f - 0.5) / 0.03)  // clearance easing at full moon (§5.2)

            const limb = y => Math.sqrt(Math.max(0, R * R - y * y))
            // band partition y_i = −R·cos(π·i/N) — equalizes worst-case facet error (§4)
            const ys = [...Array(N + 1)].map((_, i) => -R * Math.cos(Math.PI * i / N))

            const rot = ([x, y], deg) => {
                const a = deg * Math.PI / 180, cs = Math.cos(a), sn = Math.sin(a)
                return [cs * x - sn * y, sn * x + cs * y]
            }

            // ---- §5 blade placement law: outline of blade i on a given edge curve ----
            // Returns 6 vertices in the SPEC frame (+x → 3 o'clock, +y → 6 o'clock).
            // darkSign: which side of the chord normal n0 is the blade's dark/body side
            //           (+1 for bank L, −1 for bank R); bodySign: body closure x direction.
            const bladeOutline = (i, curve, shifted, darkSign, bodySign) => {
                const y0 = ys[i - 1], y1 = ys[i]
                // 1. chord between the curve points of the band
                let A = [curve(y0), y0], B = [curve(y1), y1]
                const len = Math.hypot(B[0] - A[0], B[1] - A[1])
                const u = [(B[0] - A[0]) / len, (B[1] - A[1]) / len]   // unit chord
                const n0 = [-u[1], u[0]]                               // chord normal
                if (shifted) {
                    // 2. measured deviation of the true curve at the band midpoint
                    const ym = (y0 + y1) / 2
                    const dev = (curve(ym) - A[0]) * n0[0] + (ym - y0) * n0[1]
                    // 4. shift: half-sag balanced centering everywhere, blending to
                    //    full-tangent + 0.07 overshoot toward the sky near new moon
                    const sh = dev * (0.5 + 0.5 * w) + Math.sign(dev) * 0.07 * w
                    // 5. edge = chord translated by sh·n0
                    A = [A[0] + sh * n0[0], A[1] + sh * n0[1]]
                    B = [B[0] + sh * n0[0], B[1] + sh * n0[1]]
                }
                // §5.1 tip treatments: pole caps on the outer ends of blades 1 and 12
                // (straight along the chord 1.2 past the pole, tip y pinned at ±(R+0.35)
                // in the sky), bevel flaps 0.55 at 55° into the local dark side elsewhere
                let tipA
                if (i === 1) {
                    tipA = [A[0] - CAP * u[0], -CAP_Y]
                } else {
                    const d = rot([-u[0], -u[1]], -darkSign * FLAP_DEG)
                    tipA = [A[0] + FLAP * d[0], A[1] + FLAP * d[1]]
                }
                let tipB
                if (i === N) {
                    tipB = [B[0] + CAP * u[0], CAP_Y]
                } else {
                    const d = rot(u, darkSign * FLAP_DEG)
                    tipB = [B[0] + FLAP * d[0], B[1] + FLAP * d[1]]
                }
                // §5.1 body far side: rectangle closure at width W = 2·s_max + 0.6 (§4.1)
                const yInner = y0 <= 0 && y1 >= 0 ? 0 : Math.min(Math.abs(y0), Math.abs(y1))
                const W = 2 * limb(yInner) + 0.6
                return [tipA, A, B, tipB,
                    [tipB[0] + bodySign * W, tipB[1]],
                    [tipA[0] + bodySign * W, tipA[1]]]
            }

            // ---- §6.2 bank states vs f: deployed / parked, with the two return sweeps
            // (pre-deploy and flyback, §6.3) rendered as a smooth 0.5-day interpolation
            const tL = f >= 0.988 || f < 0.5 ? 1 : f >= 0.97 ? (f - 0.97) / 0.018 : 0
            const tR = f >= 0.5 || f < 0.012 ? 1 : f < 0.03 ? 1 - (f - 0.012) / 0.018 : 0

            const xtL = y => c * limb(y)              // §4 terminator, waxing: dark = x < xt
            const xtR = y => -c * limb(y)             // §4 terminator, waning: dark = x > xt
            // §5.2 parked edge, just off the limb. Parked chords are unshifted (per §5 the
            // centering shift applies to deployed banks only; DWG-02 ground truth), so at
            // full moon (E→0) their sagitta leaves ~43 µm limb facets — sub-acuity residual.
            const parkL = y => -(limb(y) + PK * E)
            const parkR = y => limb(y) + PK * E

            const mix = (a, b, t) => a.map((p, k) =>
                [p[0] + (b[k][0] - p[0]) * t, p[1] + (b[k][1] - p[1]) * t])
            const bankBlades = (deployedCurve, parkedCurve, darkSign, bodySign, t) => {
                const s = t * t * (3 - 2 * t)         // smoothstep over the sweep window
                return [...Array(N)].map((_, k) => mix(
                    bladeOutline(k + 1, parkedCurve, false, darkSign, bodySign),
                    bladeOutline(k + 1, deployedCurve, true, darkSign, bodySign), s))
            }
            const bladesL = bankBlades(xtL, parkL, +1, -1, tL)
            const bladesR = bankBlades(xtR, parkR, -1, +1, tR)

            // ---- build 3D — SPEC frame (x, y·toward-6) maps to world (x, −y), face +Z:
            // Polygon + Extrude(+Y) rotated +90° about X does exactly that, with the
            // extrusion thickness landing in [z0, z0 + th]
            const solidify = (pts, z0, th, material) => ApplyMaterial({
                input: Transform({
                    input: Extrude({
                        input: Polygon({ points: pts.map(p => [p[0] * MM, p[1] * MM]) }),
                        height: th * MM,
                    }),
                    rotate: [90, 0, 0],
                    translate: [0, 0, z0 * MM],
                }),
                material,
            })
            const disc = (r, z0, th, material, res, at = [0, 0]) => ApplyMaterial({
                input: Transform({
                    input: Cylinder({
                        height: th * MM, radiusLow: r * MM,
                        resolution: res, anchor: [0.5, 0, 0.5],
                    }),
                    rotate: [90, 0, 0],
                    translate: [at[0] * MM, -at[1] * MM, z0 * MM],
                }),
                material,
            })

            // ---- §8 stack (z in mm, moon-plate top = 0, dial side toward +Z):
            // moon plate 0.20 · clearance 0.05 · bank L 0.12 · clearance 0.05 · bank R 0.12
            const zL = 0.05, zR = 0.22
            const PLATE_R = 18.25                     // hardware bound: module OD ≤ 36.5 (§8)

            const plate = disc(PLATE_R, -0.2, 0.2, assets.skyLacquer, 192)
            const moonDisc = disc(R, 0, 0.01, assets.moonChampagne, 160)
            const camRing = ApplyMaterial({
                input: Transform({
                    input: Extrude({
                        input: Difference([
                            Circle({ radius: PLATE_R * MM, resolution: 192 }),
                            Circle({ radius: 16.4 * MM, resolution: 192 }),
                        ]),
                        height: 0.45 * MM,
                    }),
                    rotate: [90, 0, 0],
                    translate: [0, 0, -0.65 * MM],
                }),
                material: assets.ringSteel,
            })

            const blades = [
                ...bladesL.map(pts => solidify(pts, zL, TH, assets.bladePvd)),
                ...bladesR.map(pts => solidify(pts, zR, TH, assets.bladePvd)),
            ]
            return Group([plate, camRing, moonDisc, ...blades])
        produces: MESHES
main.moon.webp: !!binary |
