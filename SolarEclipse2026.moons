# moons v1
main.moon: |
    moon: "1.0"
    doc: |
        Total Solar Eclipse of 12 August 2026 — computed from real data.
        A miniature Earth wearing a computed texture: filled Natural Earth
        continents, the real day/night terminator at the moment of greatest
        eclipse (the eclipse ends at sunset over Spain), and the swept region
        of partial visibility shaded amber per-pixel from the moving penumbra.
        The path of totality is computed geometry: the central line (red tube)
        and the totality band at its true ~300 km ground width, sunrise in
        northern Siberia to sunset over the Balearics. Moon and Sun sit along
        the true shadow-axis direction — visibly grazing the Earth near the
        pole (gamma 0.898), which is why the path runs so far north.

        The math: shadow-axis elements in the Besselian frame. d and mu
        (axis declination / Greenwich hour angle) are computed per-minute
        from a solar ephemeris (~0.01 deg). The axis track x(t), y(t) is
        derived in-code from the published circumstances of this eclipse
        (NASA/EclipseWise: greatest eclipse 17:46:01 UT at 65.2N 25.2W,
        gamma 0.8977, central duration ~16:59-18:33 UT, penumbra radius
        0.536, effective umbra radius 0.0105 Earth radii) — a low-precision
        lunar ephemeris cannot place a 300 km shadow, so the published
        circumstances stand in for the high-precision part, exactly the job
        Besselian elements do. Everything downstream is computed: central
        line, band width, partial region, contact times. Self-checks verify
        computed gamma, the GE round-trip, and the penumbral contact times
        P1/P4 against the independent published 15:34 / 19:57 UT — broken
        math refuses to render.
        The `time` param scrubs through the central eclipse (umbra on the
        surface, ~17:00-18:33 UTC): Moon, Sun, shadow cones, footprints,
        terminator and labels all move along the computed track (default 0 =
        greatest eclipse, 17:46:01 UTC); the red band and the amber shading
        stay as the whole-event summary.

        Proportions: distances are compressed so all three bodies share one
        view (the legend plaque shows the computed factors), but the Moon and
        Sun sizes are DERIVED from the real umbral cone angle at those
        compressed distances: one straight cone runs from the computed umbra
        footprint, encloses the Moon's limb tangentially, and continues to
        meet the Sun's limb exactly - both bodies keep their true ~0.5 degree
        angular size as seen from the eclipse point.
        Data: Natural Earth 110m land polygons (public domain), published
        eclipse circumstances (eclipse.gsfc.nasa.gov / eclipsewise.com).
    params:
        earthRadius:
            default: 0.5
            doc: |
                Earth radius in meters (scene scale).
            category: Scale
            min: 0.2
            max: 1
        time:
            default: 0
            label: Time
            doc: |
                Minutes from greatest eclipse (17:46 UTC). The umbra races
                its whole track - local sunrise in Siberia to local sunset
                over the Balearics - in these 93 minutes (~1.8 km/s).
            category: Time
            min: -46
            max: 46
            step: 1
        distanceRealism:
            default: 0.22
            doc: |
                Distance compression: 1 = true scale, smaller pulls Moon and
                Sun closer (far things more). Sizes follow automatically.
            category: Scale
            min: 0.15
            max: 1
            step: 0.01
        showShadowCones:
            default: true
            kind: boolean
            doc: |
                Show the umbra/penumbra cones and the tangent light cone.
            category: Eclipse
        showSunlight:
            default: true
            kind: boolean
            doc: |
                Show the sunlight envelope hugging the day side.
            category: Eclipse
        showDistances:
            default: true
            kind: boolean
            doc: |
                Show the labeled Moon and Sun distance lines.
            category: Eclipse
    assets:
        # Natural Earth 110m land polygons: one closed ring per ring id.
        land:
            import: ./assets/land.csv

        # ── THE ECLIPSE ── shadow-axis elements and everything derived from
        # them, in one DATA record so texture and geometry can never disagree.
        # Scene frame: x = cos(lat) cos(lon), y = sin(lat), z = -cos(lat) sin(lon)
        # (Greenwich on +X, north up).
        eclipse:
            expression: |
                const rad = a => a * Math.PI / 180
                const deg = r => r * 180 / Math.PI
                const wrap360 = a => ((a % 360) + 360) % 360
                const dot = (a, b) => a[0] * b[0] + a[1] * b[1] + a[2] * b[2]
                const dirV = (lat, lon) => {
                    const p = rad(lat), l = rad(lon)
                    return [Math.cos(p) * Math.cos(l), Math.sin(p), -Math.cos(p) * Math.sin(l)]
                }

                // Published circumstances (NASA / EclipseWise), the anchors:
                const GE = { lat: 65.2, lon: -25.2, gamma: 0.8977, utc: 17.7669 }  // 17:46:01 UT
                const centralHalfHours = 0.78   // central eclipse ~16:59 -> ~18:33 UT
                const l1 = 0.536                // penumbra radius on the fundamental plane (Earth radii)
                const l2u = 0.0105              // effective umbral half-width (|l2| + zeta tanF2)
                const tanF2 = 0.00459           // umbral cone half-angle (tan), NASA elements

                // Days from J2000.0 at tau hours from greatest eclipse
                // (2026-08-12 00:00 UT = J2000 + 9719.5 d)
                const D0 = 9719.5 + GE.utc / 24

                // Solar ephemeris (good to ~0.01 deg): RA, dec, GMST at tau
                const sunEq = tau => {
                    const D = D0 + tau / 24
                    const g = rad(wrap360(357.528 + 0.9856003 * D))
                    const lam = wrap360(280.460 + 0.9856474 * D) + 1.915 * Math.sin(g) + 0.020 * Math.sin(2 * g)
                    const eps = 23.439 - 0.0000004 * D
                    const sl = Math.sin(rad(lam)), cl = Math.cos(rad(lam))
                    const se = Math.sin(rad(eps)), ce = Math.cos(rad(eps))
                    return [wrap360(deg(Math.atan2(sl * ce, cl))), deg(Math.asin(sl * se)),
                            wrap360(280.46061837 + 360.98564736629 * D)]
                }
                // Fundamental-plane basis in the scene frame at tau: zhat toward
                // the Sun, yhat north-perpendicular, xhat east. d = axis
                // declination, mu = its Greenwich hour angle (subsolar lon = -mu).
                const frame = tau => {
                    const [ra, dec, gmst] = sunEq(tau)
                    const mu = wrap360(gmst - ra)
                    const d = rad(dec), m = rad(mu)
                    return {
                        xhat: [Math.sin(m), 0, -Math.cos(m)],
                        yhat: [-Math.sin(d) * Math.cos(m), Math.cos(d), -Math.sin(d) * Math.sin(m)],
                        zhat: [Math.cos(d) * Math.cos(m), Math.sin(d), Math.cos(d) * Math.sin(m)],
                        d: dec, mu,
                    }
                }

                // Shadow-axis track: project the published GE point into the
                // fundamental plane at tau = 0 -> (xg, yg); the axis velocity is
                // perpendicular to that offset (definition of greatest eclipse),
                // eastward, sized by the central duration.
                const f0 = frame(0)
                const P = dirV(GE.lat, GE.lon)
                const xg = dot(P, f0.xhat), yg = dot(P, f0.yhat), zg = dot(P, f0.zhat)
                const gamma = Math.hypot(xg, yg)
                if (Math.abs(gamma - GE.gamma) > 0.02)
                    throw new Error(`derived gamma ${gamma.toFixed(4)} vs published 0.8977 - ephemeris or frame math broken`)
                if (zg <= 0)
                    throw new Error("greatest-eclipse point landed on the night side - frame sign error")
                const vmag = Math.sqrt(1 - gamma * gamma) / centralHalfHours
                const vx = vmag * yg / gamma, vy = -vmag * xg / gamma
                const nx = -vy / vmag, ny = vx / vmag   // path normal (north side)

                // Ground point under the shadow axis at tau, offset e Earth radii
                // perpendicular to the track (e = +-l2u gives the totality limits;
                // the slanted sphere projection stretches it to the true width).
                const project = (tau, e) => {
                    const f = frame(tau)
                    const x = xg + vx * tau + e * nx, y = yg + vy * tau + e * ny
                    const zz = 1 - x * x - y * y
                    if (zz <= 0) return null
                    const z = Math.sqrt(zz)
                    const p = [0, 1, 2].map(i => x * f.xhat[i] + y * f.yhat[i] + z * f.zhat[i])
                    return [deg(Math.asin(p[1])), deg(Math.atan2(-p[2], p[0]))]
                }
                // Self-check: tau = 0 must round-trip to the published GE point
                const back = project(0, 0)
                if (Math.abs(back[0] - GE.lat) > 0.3 || Math.abs(wrap360(back[1] - GE.lon + 180) - 180) > 0.6)
                    throw new Error(`GE round-trip gave ${back[0].toFixed(1)}, ${back[1].toFixed(1)} - projection math broken`)
                // Self-check: penumbral contacts P1/P4 (|r| = 1 + l1) against the
                // INDEPENDENT published times 15:34 / 19:57 UT.
                const rAt = tau => Math.hypot(xg + vx * tau, yg + vy * tau)
                let p1 = null, p4 = null
                for (let tau = -3.5; tau <= 3.5; tau += 0.005) {
                    if (rAt(tau) < 1 + l1) { if (p1 === null) p1 = tau; p4 = tau }
                }
                if (p1 === null || Math.abs(GE.utc + p1 - 15.57) > 0.4 || Math.abs(GE.utc + p4 - 19.95) > 0.4)
                    throw new Error(`computed P1/P4 = ${(GE.utc + p1).toFixed(2)} / ${(GE.utc + p4).toFixed(2)} UT vs published 15.57 / 19.95 - track math broken`)

                // Central line and totality limits (paired, for the band strip)
                const path = [], bandN = [], bandS = []
                const NS = 72
                for (let k = 0; k <= NS; k++) {
                    const tau = -centralHalfHours + 2 * centralHalfHours * k / NS
                    const c = project(tau, 0)
                    if (!c) continue
                    path.push(c)
                    const n2 = project(tau, l2u), s2 = project(tau, -l2u)
                    if (n2 && s2) { bandN.push(n2); bandS.push(s2) }
                }
                if (path.length < 40)
                    throw new Error(`only ${path.length} central-line points projected - track math broken`)

                // ── THE INSTANT SHOWN ── everything below is evaluated at the
                // time param (minutes from greatest eclipse): axis position,
                // frame, the anchor point under the axis, and the instantaneous
                // footprints - circles of radius l1 (penumbra) / l2u (umbra)
                // around the shadow axis, projected onto the sphere. Where the
                // penumbra circle leaves the Earth it is clamped to the limb -
                // which in this frame IS the terminator, so the partial zone is
                // correctly bounded by the sunrise/sunset line.
                const tauNow = params.time / 60
                const fT = frame(tauNow)
                const xT = xg + vx * tauNow, yT = yg + vy * tauNow
                const rT = Math.hypot(xT, yT)
                const zetaT = rT < 1 ? Math.sqrt(1 - rT * rT) : 0
                // scene-frame unit anchor: the point under the shadow axis (on
                // the surface while the umbra touches, else on the fundamental
                // plane beside the limb)
                const anchor = [0, 1, 2].map(i => xT * fT.xhat[i] + yT * fT.yhat[i] + zetaT * fT.zhat[i])
                const outlineT = (radius, n) => {
                    const pts = []
                    for (let k = 0; k < n; k++) {
                        const th = 2 * Math.PI * k / n
                        let u = xT + radius * Math.cos(th), v = yT + radius * Math.sin(th)
                        const r2 = u * u + v * v
                        if (r2 > 0.9999) { const s = Math.sqrt(0.9999 / r2); u *= s; v *= s }
                        const z = Math.sqrt(Math.max(0, 1 - u * u - v * v))
                        const p = [0, 1, 2].map(i => u * fT.xhat[i] + v * fT.yhat[i] + z * fT.zhat[i])
                        pts.push([deg(Math.asin(p[1])), deg(Math.atan2(-p[2], p[0]))])
                    }
                    return pts
                }
                const penumbraOutline = rT - l1 < 0.999 ? outlineT(l1, 144) : []
                const umbraOutline = rT - l2u < 0.999 ? outlineT(l2u, 72) : []

                // Time samples for the per-pixel partial shading (P1 to P4)
                const samples = []
                for (let tau = -2.3; tau <= 2.31; tau += 0.2) {
                    const f = frame(tau)
                    samples.push([xg + vx * tau, yg + vy * tau, f.d, f.mu])
                }

                const subLon = wrap360(-fT.mu + 180) - 180
                return { geLat: GE.lat, geLon: GE.lon, gamma, subLat: fT.d, subLon,
                         anchor, touching: zetaT > 0,
                         l1, l2u, tanF2, path, bandN, bandS, samples, penumbraOutline, umbraOutline }

        # ── THE TEXTURE ── filled Natural Earth continents, day/night at the
        # moment of greatest eclipse, and the swept partial-visibility region
        # shaded amber per-pixel: max eclipse magnitude over the P1-P4 samples,
        # each gated to that instant's day side. (Totality is geometry, not
        # texture: at 0.0105 Earth radii the umbra falls between time samples.)
        earthTex:
            expression: |
                const rad = a => a * Math.PI / 180
                const ec = assets.eclipse
                // land mask: rings filled by the nonzero winding rule
                const ringIds = Array.from(assets.land.col("ring"), Number)
                const llon = Array.from(assets.land.col("lon"), Number)
                const llat = Array.from(assets.land.col("lat"), Number)
                const ringPts = []
                let cur = null, curId = -1
                for (let i = 0; i < ringIds.length; i++) {
                    if (ringIds[i] !== curId) { cur = []; ringPts.push(cur); curId = ringIds[i] }
                    cur.push([llon[i], llat[i]])
                }
                const TH = 360, TW = 720
                const landImg = Rasterize({
                    input: Group(ringPts.map(p => Polygon({ points: p }))),
                    size: [TH, TW], region: [[-180, -90], [180, 90]],
                    fill: [1, 1, 1], background: [0, 0, 0], antialias: true,
                })
                const landF = Split({ input: landImg.values, axis: 2 })[0]
                const landFrac = Mean({ input: landF, axis: null })
                if (landFrac < 0.15 || landFrac > 0.5)
                    throw new Error(`land mask covers ${(landFrac * 100).toFixed(0)}% of the map - land.csv or the rasterization is broken`)
                // pixel direction field (texture row 0 = lat -90; mesh flips V)
                const [tx, ty] = Coords({ shape: [TH, TW], normalize: true })
                const plat = (ty - 0.5) * Math.PI
                const plon = tx * (2 * Math.PI) - Math.PI
                const cosLat = Cos(plat)
                const px = cosLat * Cos(plon), py = Sin(plat), pz = cosLat * Sin(plon) * -1
                // day/night at greatest eclipse (subsolar point from the ephemeris)
                const sp = rad(ec.subLat), sl = rad(ec.subLon)
                const sub = [Math.cos(sp) * Math.cos(sl), Math.sin(sp), -Math.cos(sp) * Math.sin(sl)]
                const dayF = Smoothstep({ input: px * sub[0] + py * sub[1] + pz * sub[2], edge0: -0.08, edge1: 0.08 })
                // max eclipse magnitude over the time samples
                let mag = Zeros({ shape: [TH, TW] })
                for (const row of ec.samples) {
                    const [x, y, dd, mu] = row
                    const d = rad(dd), m = rad(mu)
                    const xh = [Math.sin(m), 0, -Math.cos(m)]
                    const yh = [-Math.sin(d) * Math.cos(m), Math.cos(d), -Math.sin(d) * Math.sin(m)]
                    const zh = [Math.cos(d) * Math.cos(m), Math.sin(d), Math.cos(d) * Math.sin(m)]
                    const dx = px * xh[0] + py * xh[1] + pz * xh[2] - x
                    const dy = px * yh[0] + py * yh[1] + pz * yh[2] - y
                    const zp = px * zh[0] + py * zh[1] + pz * zh[2]
                    const m1 = (ec.l1 - Sqrt(dx * dx + dy * dy)) / (ec.l1 + ec.l2u)
                    mag = Maximum({ input: mag, other: m1 * Step({ input: zp, edge: 0 }) })
                }
                mag = Clamp({ input: mag, min: 0, max: 1 })
                // colors: day/night base, amber partial shading on top
                const oceanD = [0.20, 0.42, 0.66], landD = [0.52, 0.60, 0.47]
                const oceanN = [0.07, 0.10, 0.18], landN = [0.14, 0.16, 0.17]
                const amber = [1, 0.62, 0.1]
                const tPart = mag ** 1.6 * 0.55
                const chan = i => Mix({
                    input: Mix({
                        input: Mix({ input: oceanN[i], target: landN[i], t: landF }),
                        target: Mix({ input: oceanD[i], target: landD[i], t: landF }),
                        t: dayF,
                    }),
                    target: amber[i], t: tPart,
                })
                return Image(StackAxis({ input: [chan(0), chan(1), chan(2)], axis: 2 }))
            produces: IMAGE
        earthMaterial:
            op: Material
            with:
                color:
                    asset: earthTex
                roughness:
                    expression: |
                        return Image(Fill({ value: 0.7, shape: [8, 8] }))
                    produces: IMAGE

        # The globe: lon/lat vertex grid with equirect UVs and exact radial
        # normals; pole cells drop their degenerate sliver triangle.
        earth:
            expression: |
                const RE = params.earthRadius
                const GH = 73, GW = 145
                const [gu, gv] = Coords({ shape: [GH, GW], normalize: true })
                const glat = (0.5 - gv) * Math.PI
                const gang = gu * (2 * Math.PI) - Math.PI
                const gCosLat = Cos(glat)
                const gx = gCosLat * Cos(gang), gy = Sin(glat), gz = gCosLat * Sin(gang) * -1
                const gtris = []
                for (let r = 0; r < GH - 1; r++) {
                    for (let c = 0; c < GW - 1; c++) {
                        const a = r * GW + c, b = a + 1, d = a + GW, e = d + 1
                        if (r < GH - 2) gtris.push([a, d, e])
                        if (r > 0) gtris.push([a, e, b])
                    }
                }
                return Mesh({
                    vertices: Reshape({ input: StackAxis({ input: [gx * RE, gy * RE, gz * RE], axis: 2 }), newShape: [GH * GW, 3] }),
                    triangles: gtris,
                    normals: Reshape({ input: StackAxis({ input: [gx, gy, gz], axis: 2 }), newShape: [GH * GW, 3] }),
                    materialUVs: Reshape({ input: StackAxis({ input: [gu, 1 - gv], axis: 2 }), newShape: [GH * GW, 2] }),
                    material: assets.earthMaterial,
                })
            produces: MESHES

        # ── PATH GEOMETRY ── computed central line (tube) and the totality
        # band at its true ground width (a double-sided strip between the
        # computed north/south limits), draped just above the surface.
        pathGeometry:
            expression: |
                const rad = a => a * Math.PI / 180
                const ec = assets.eclipse
                const R = params.earthRadius
                const toXyz = (lat, lon, r) => {
                    const p = rad(lat), l = rad(lon)
                    return [r * Math.cos(p) * Math.cos(l), r * Math.sin(p), -r * Math.cos(p) * Math.sin(l)]
                }
                const parts = []
                // totality band strip between the computed limits
                const N = ec.bandN.length
                const verts = [], tris = [], norms = []
                for (let k = 0; k < N; k++) {
                    const [an, on] = ec.bandN[k]
                    const [as2, os] = ec.bandS[k]
                    verts.push(toXyz(an, on, R * 1.004), toXyz(as2, os, R * 1.004))
                    norms.push(toXyz(an, on, 1), toXyz(as2, os, 1))
                    if (k > 0) {
                        const a = 2 * (k - 1), b = a + 1, c = a + 2, d = a + 3
                        tris.push([a, c, b], [b, c, d], [a, b, c], [b, d, c])  // double-sided
                    }
                }
                parts.push(ApplyMaterial({
                    input: Mesh({ vertices: verts, triangles: tris, normals: norms }),
                    material: Material({ color: [0.95, 0.25, 0.1, 0.85], roughness: 0.7 }),
                }))
                // central line tube
                const path = ec.path.map(([lat, lon]) => toXyz(lat, lon, R * 1.007))
                parts.push(ApplyMaterial({
                    input: Sweep({ input: Circle({ radius: 0.004, resolution: 12 }), path, resolution: 1 }),
                    material: Material({ color: [0.6, 0.03, 0.03, 1], roughness: 0.5 }),
                }))
                return Group(parts)
            produces: MESHES
        # ── FOOTPRINTS ── the computed intersection of the shadow cones with
        # the surface at the instant of greatest eclipse: the penumbra oval
        # (amber ring, limb-clamped where it slides off the day side) and the
        # umbra ellipse (dark ring + filled patch, ~300 km, stretched by the
        # grazing incidence).
        footprints:
            expression: |
                const rad = a => a * Math.PI / 180
                const ec = assets.eclipse
                const R = params.earthRadius
                const toXyz = ([lat, lon], r) => {
                    const p = rad(lat), l = rad(lon)
                    return [r * Math.cos(p) * Math.cos(l), r * Math.sin(p), -r * Math.cos(p) * Math.sin(l)]
                }
                const parts = []
                // penumbra boundary ring (absent before P1 / after P4)
                if (ec.penumbraOutline.length > 2)
                    parts.push(ApplyMaterial({
                        input: Sweep({
                            input: Circle({ radius: 0.0035, resolution: 12 }),
                            path: ec.penumbraOutline.map(p => toXyz(p, R * 1.005)),
                            resolution: 1, closed: true,
                        }),
                        material: Material({ color: [1, 0.72, 0.15, 1], roughness: 0.5 }),
                    }))
                // umbra footprint: filled dark ellipse + thin outline (only while
                // the umbra actually touches the surface)
                if (ec.touching && ec.umbraOutline.length > 2) {
                    const ring = ec.umbraOutline.map(p => toXyz(p, R * 1.0055))
                    const center = [...ec.anchor].map(c => c * R * 1.0055)
                    const verts = [center, ...ring]
                    const tris = []
                    for (let k = 0; k < ring.length; k++) {
                        const a = 1 + k, b = 1 + (k + 1) % ring.length
                        tris.push([0, a, b], [0, b, a])   // double-sided fan
                    }
                    parts.push(ApplyMaterial({
                        input: Mesh({ vertices: verts, triangles: tris }),
                        material: Material({ color: [0.08, 0.06, 0.1, 0.95], roughness: 0.8 }),
                    }))
                    parts.push(ApplyMaterial({
                        input: Sweep({
                            input: Circle({ radius: 0.0018, resolution: 8 }),
                            path: ec.umbraOutline.map(p => toXyz(p, R * 1.006)),
                            resolution: 1, closed: true,
                        }),
                        material: Material({ color: [0.05, 0.04, 0.08, 1], roughness: 0.6 }),
                    }))
                }
                if (parts.length === 0) return []
                return Group(parts)
            produces: MESHES
        geMarker:
            doc: |
                Gold marker at the point of greatest eclipse (65.2N 25.2W,
                17:46:01 UT, totality 2m18s).
            expression: |
                const ec = assets.eclipse
                const rad = a => a * Math.PI / 180
                const r = params.earthRadius * 1.012
                const p = rad(ec.geLat), l = rad(ec.geLon)
                const pos = [r * Math.cos(p) * Math.cos(l), r * Math.sin(p), -r * Math.cos(p) * Math.sin(l)]
                return ApplyMaterial({
                    input: Transform({ input: Sphere({ radius: 0.008, resolution: 24 }), translate: pos }),
                    material: Material({ color: [1, 0.85, 0.2, 1], roughness: 0.3, metallic: 0.6 }),
                })
            produces: MESHES

        # ── MOON & SUN ── on the true shadow-axis line through the greatest-
        # eclipse point (the real grazing geometry of gamma 0.898). Sizes are
        # DERIVED from the real umbral cone angle tanF2 at the compressed
        # distances: one straight cone runs from the computed footprint,
        # encloses the Moon's limb tangentially, and continues to meet the
        # Sun's limb exactly - angular sizes stay true (~0.5 deg).
        celestial:
            expression: |
                const rad = a => a * Math.PI / 180
                const ec = assets.eclipse
                const R = params.earthRadius
                // one knob, both bodies: scene distance = R * (eclipse-day true
                // distance in Earth radii) ^ p along the axis; p = 1 is exact.
                // 57.12 / 23782 are the distances the real cone angle implies
                // for the bodies' true radii (Moon near perigee - the reason
                // this eclipse is total; Sun at 1.014 au): at p = 1 the Moon
                // comes out at its true 0.273 Re and the Sun at 109.2 Re.
                const moonDist = R * 57.12 ** params.distanceRealism
                const sunDist = R * 23782 ** params.distanceRealism
                const aOff = ec.l2u / ec.tanF2 * R   // umbra apex depth beyond the surface (scaled true)
                const moonR = (aOff + moonDist) * ec.tanF2
                const sunR = (aOff + sunDist) * ec.tanF2
                const dirV = (lat, lon) => {
                    const p = rad(lat), l = rad(lon)
                    return [Math.cos(p) * Math.cos(l), Math.sin(p), -Math.cos(p) * Math.sin(l)]
                }
                const z = dirV(ec.subLat, ec.subLon)          // shadow-axis direction at the shown time
                const gp = [...ec.anchor].map(c => c * R)     // point under the axis at the shown time
                const at = (base, s) => [base[0] + z[0] * s, base[1] + z[1] * s, base[2] + z[2] * s]
                const parts = []
                parts.push(ApplyMaterial({
                    input: Transform({ input: Sphere({ radius: moonR, resolution: 48 }), translate: at(gp, moonDist) }),
                    material: Material({ color: [0.52, 0.51, 0.5, 1], roughness: 0.95 }),
                }))
                parts.push(ApplyMaterial({
                    input: Transform({ input: Sphere({ radius: sunR, resolution: 48 }), translate: at(gp, sunDist) }),
                    material: Material({ color: [1, 0.8, 0.15, 1], roughness: 0.25 }),
                }))
                // glow shell so the (now small, honestly-scaled) Sun still reads bright
                parts.push(ApplyMaterial({
                    input: Transform({ input: Sphere({ radius: sunR * 2, resolution: 32 }), translate: at(gp, sunDist) }),
                    material: Material({ color: [1, 0.85, 0.35, 0.25], roughness: 0.6 }),
                }))
                if (params.showShadowCones) {
                    const rotX = Math.acos(z[1]) * 180 / Math.PI
                    const rotY = Math.atan2(z[0], z[2]) * 180 / Math.PI
                    // the ONE tangent cone, unbroken: footprint -> Moon limb ->
                    // Sun limb. Radius grows linearly at the real tanF2 the whole
                    // way (at s: l2u*R + s*tanF2, which equals moonR at the Moon
                    // and sunR at the Sun by construction).
                    parts.push(ApplyMaterial({
                        input: Transform({
                            input: Cylinder({ height: sunDist, radiusLow: ec.l2u * R, radiusHigh: sunR, resolution: 32, anchor: [0.5, 0, 0.5] }),
                            rotate: [rotX, rotY, 0], translate: gp,
                        }),
                        material: Material({ color: [0.22, 0.22, 0.3, 0.2], roughness: 0.9 }),
                    }))
                    // the umbra: the SAME cone's shadow segment (Moon down to the
                    // footprint), darkened and nested a hair inside the envelope
                    parts.push(ApplyMaterial({
                        input: Transform({
                            input: Cylinder({ height: moonDist, radiusLow: ec.l2u * R * 0.99, radiusHigh: moonR * 0.99, resolution: 32, anchor: [0.5, 0, 0.5] }),
                            rotate: [rotX, rotY, 0], translate: gp,
                        }),
                        material: Material({ color: [0.08, 0.08, 0.14, 0.55], roughness: 0.9 }),
                    }))
                    // penumbra: a RULED sheet - one ray from each point of the
                    // Moon's limb to the matching point of the computed footprint
                    // ring, so it lands exactly on the amber outline. (A straight
                    // cone cannot: the footprint curve is non-planar on the sphere,
                    // and the compressed distances exaggerate any fixed slope.)
                    if (ec.penumbraOutline.length > 2) {
                    const d0 = rad(ec.subLat), mu0 = rad(-ec.subLon)
                    const xh = [Math.sin(mu0), 0, -Math.cos(mu0)]
                    const yh = [-Math.sin(d0) * Math.cos(mu0), Math.cos(d0), -Math.sin(d0) * Math.sin(mu0)]
                    const moonC = at(gp, moonDist)
                    const K = ec.penumbraOutline.length
                    const pv = [], pt = [], pn = []
                    for (let k = 0; k < K; k++) {
                        const th = 2 * Math.PI * k / K
                        const ct = Math.cos(th), st = Math.sin(th)
                        const [la, lo] = ec.penumbraOutline[k]
                        const q = rad(la), l = rad(lo)
                        pv.push([R * 1.005 * Math.cos(q) * Math.cos(l), R * 1.005 * Math.sin(q), -R * 1.005 * Math.cos(q) * Math.sin(l)])
                        pv.push([moonC[0] + (xh[0] * ct + yh[0] * st) * moonR,
                                 moonC[1] + (xh[1] * ct + yh[1] * st) * moonR,
                                 moonC[2] + (xh[2] * ct + yh[2] * st) * moonR])
                        // explicit smooth normal (radial off the axis), shared by
                        // both rails and both windings - avoids striped shading
                        const nr = [xh[0] * ct + yh[0] * st, xh[1] * ct + yh[1] * st, xh[2] * ct + yh[2] * st]
                        pn.push(nr, nr)
                    }
                    for (let k = 0; k < K; k++) {
                        const a = 2 * k, b = a + 1, c = 2 * ((k + 1) % K), d2 = c + 1
                        pt.push([a, c, b], [b, c, d2], [a, b, c], [b, d2, c])   // double-sided
                    }
                    parts.push(ApplyMaterial({
                        input: Mesh({ vertices: pv, triangles: pt, normals: pn }),
                        material: Material({ color: [1, 0.93, 0.6, 0.055], roughness: 0.9 }),
                    }))
                    }
                }
                if (params.showSunlight) {
                    // the sunlight envelope: every ray from the Sun's disc that the
                    // Earth intercepts - a frustum from the Sun's limb down to the
                    // Earth's limb, tangent at the terminator. Subtracting the globe
                    // leaves it wrapping the day hemisphere as a faint glowing skin.
                    const sunPos = at(gp, sunDist)
                    const L = Math.hypot(sunPos[0], sunPos[1], sunPos[2])
                    const a2 = sunPos.map(c => c / L)
                    const rX = Math.acos(a2[1]) * 180 / Math.PI
                    const rY = Math.atan2(a2[0], a2[2]) * 180 / Math.PI
                    parts.push(ApplyMaterial({
                        input: Difference([
                            Transform({
                                input: Cylinder({ height: L, radiusLow: R, radiusHigh: sunR, resolution: 64, anchor: [0.5, 0, 0.5] }),
                                rotate: [rX, rY, 0],
                            }),
                            Sphere({ radius: R * 1.003, resolution: 64 }),
                        ]),
                        material: Material({ color: [1, 0.95, 0.75, 0.055], roughness: 0.9 }),
                    }))
                }
                return Group(parts)
            produces: MESHES
        label:
            doc: |
                Flat extruded lettering: a string to 3D glyphs lying in the XZ
                plane, centered on the origin, face toward +Y. (Text cannot be
                called inside an expression, so this factory wraps it.)
            params:
                text: X
                size: 0.05
            render:
                pipe:
                  - op: Text
                    with:
                        text:
                            param: text
                        fontSize:
                            param: size
                        alignX: center
                        alignY: center
                  - op: Extrude
                    with:
                        height: 0.006
        # ── DIMENSION LINES ── Moon and Sun distances as technical dimension
        # lines along the shadow axis: bar-ended lines offset sideways from
        # the cones, labeled with the real distance and the computed
        # compression factor of this scene.
        distanceMarkers:
            expression: |
                if (!params.showDistances) return []
                const rad = a => a * Math.PI / 180
                const ec = assets.eclipse
                const R = params.earthRadius
                const p = params.distanceRealism
                const moonDist = R * 57.12 ** p
                const sunDist = R * 23782 ** p
                const dirV = (lat, lon) => {
                    const q = rad(lat), l = rad(lon)
                    return [Math.cos(q) * Math.cos(l), Math.sin(q), -Math.cos(q) * Math.sin(l)]
                }
                const z = dirV(ec.subLat, ec.subLon)
                const gp = [...ec.anchor].map(c => c * R)
                const cross = (a, b) => [a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0]]
                const norm3 = a => { const l = Math.hypot(a[0], a[1], a[2]); return a.map(c => c / l) }
                const add = (a, b, s) => [a[0] + b[0] * s, a[1] + b[1] * s, a[2] + b[2] * s]
                const dot = (a, b) => a[0] * b[0] + a[1] * b[1] + a[2] * b[2]
                // label frame: reading along the line, facing the +X side
                const out = norm3(add([1, 0, 0], z, -dot([1, 0, 0], z)))
                const right = z.map(c => -c)
                const up = cross(out, right)
                const n = norm3(cross(z, [0, 1, 0]))   // sideways offset off the cones
                // same compression measure as the legend (from Earth's center)
                const zg = Math.sqrt(1 - ec.gamma * ec.gamma) * R
                const dist = s => Math.sqrt(R * R + 2 * s * zg + s * s)
                const nice = v => v < 100 ? Math.round(v) : Math.round(v / 100) * 100
                const parts = []
                const lineMat = Material({ color: [0.85, 0.85, 0.9, 1], roughness: 0.5 })
                const dim = (offset, len, text, size) => {
                    const a = add(gp, n, offset), b = add(a, z, len)
                    parts.push(ApplyMaterial({ input: Sweep({ input: Circle({ radius: 0.0022, resolution: 8 }), path: [a, b] }), material: lineMat }))
                    for (const e of [a, b])
                        parts.push(ApplyMaterial({ input: Sweep({ input: Circle({ radius: 0.0022, resolution: 8 }), path: [add(e, up, -0.035), add(e, up, 0.035)] }), material: lineMat }))
                    const m = assets.label({ text, size }).meshes[0]
                    const v = Dot({ input: m.vertices, other: [right, out, [-up[0], -up[1], -up[2]]] })
                    const mid = add(add(a, z, len / 2), up, 0.055)
                    parts.push(ApplyMaterial({ input: Mesh({ vertices: v + Data(mid), triangles: m.triangles }), material: lineMat }))
                }
                const fM = nice(57.12 * R / dist(moonDist))
                const fS = nice(23782 * R / dist(sunDist))
                dim(0.16, moonDist, `Moon 364,000 km away - here ${fM}x closer`, 0.036)
                dim(0.32, sunDist, `Sun 151.5M km away - here ${fS}x closer`, 0.055)
                // body labels: true sizes, and how much smaller they are drawn
                // (sizes derive from the shadow cone at the compressed distances)
                const aOff = ec.l2u / ec.tanF2 * R
                const moonR = (aOff + moonDist) * ec.tanF2
                const sunR = (aOff + sunDist) * ec.tanF2
                const bodyLabel = (pos, text, size) => {
                    const m = assets.label({ text, size }).meshes[0]
                    const v = Dot({ input: m.vertices, other: [right, out, [-up[0], -up[1], -up[2]]] })
                    parts.push(ApplyMaterial({ input: Mesh({ vertices: v + Data(pos), triangles: m.triangles }), material: lineMat }))
                }
                bodyLabel(add(add(gp, z, moonDist), up, moonR + 0.045), `Moon 3,475 km wide - here ${nice(0.2727 * R / moonR)}x smaller`, 0.026)
                bodyLabel(add(add(gp, z, sunDist), up, sunR * 2 + 0.05), `Sun 1.39M km wide - here ${nice(109.2 * R / sunR)}x smaller`, 0.05)
                bodyLabel([0, R + 0.08, 0], `Earth 12,742 km wide`, 0.042)
                return Group(parts)
            produces: MESHES
        titlePlaque:
            doc: |
                3D title text below the globe.
            pipe:
              - op: Text
                with:
                    text:
                        expression: |
                            const t = 17 * 60 + 46 + params.time
                            const pad = v => (v < 10 ? "0" : "") + v
                            return `Total Solar Eclipse - 12 Aug 2026, ${pad(Math.floor(t / 60))}:${pad(Math.round(t % 60))} UTC`
                    fontSize: 0.13
                    alignX: center
                    alignY: center
              - op: Extrude
                with:
                    height: 0.015
              - op: Transform
                with:
                    rotate: [90, 0, 0]
                    translate: [0, -0.85, 0]
              - op: ApplyMaterial
                with:
                    material:
                        op: Material
                        with:
                            color: [0.92, 0.92, 0.95, 1]
                            roughness: 0.4
    render:
        group:
            # the scene is yawed -90 deg so the eclipse geometry's profile
            # (Earth left, cone running to Moon and Sun) is the FRONT view
          - op: Transform
            with:
                rotate: [0, -90, 0]
            input:
                group:
                  - asset: earth
                  - asset: pathGeometry
                  - asset: footprints
                  - asset: geMarker
                  - asset: celestial
                  - asset: distanceMarkers
          - asset: titlePlaque
